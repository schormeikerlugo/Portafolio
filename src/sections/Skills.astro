---
import { skills } from '../data/content';
import { t, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;

const levelColors: Record<string, { border: string; text: string; bg: string; bar: string }> = {
  EXPERT:       { border: 'border-cyan/30', text: 'text-cyan', bg: 'bg-cyan/5', bar: 'bg-cyan' },
  SPECIALIST:   { border: 'border-purple-500/30', text: 'text-purple-400', bg: 'bg-purple-500/5', bar: 'bg-purple-500' },
  ADVANCED:     { border: 'border-blue-500/30', text: 'text-blue-400', bg: 'bg-blue-500/5', bar: 'bg-blue-500' },
  INTERMEDIATE: { border: 'border-emerald-500/30', text: 'text-emerald-400', bg: 'bg-emerald-500/5', bar: 'bg-emerald-500' },
  BASIC:        { border: 'border-white/10', text: 'text-text-dim', bg: 'bg-white/5', bar: 'bg-white/40' },
};
---

<section id="skills" class="relative z-10 py-20 sm:py-24 px-6 bg-void overflow-hidden">
  <div class="max-w-[1400px] mx-auto relative z-10">
    <!-- Header -->
    <header class="skills-header mb-16 flex flex-col items-center md:items-start text-center md:text-left" data-animate>
      <div class="flex items-center gap-4 mb-2">
        <!-- Crosshair dot -->
        <div class="relative w-5 h-5 opacity-60">
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-1 h-1 bg-cyan rounded-full"></div>
          </div>
          <div class="absolute top-0 left-1/2 -translate-x-1/2 w-px h-1.5 bg-cyan/60"></div>
          <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-px h-1.5 bg-cyan/60"></div>
          <div class="absolute left-0 top-1/2 -translate-y-1/2 h-px w-1.5 bg-cyan/60"></div>
          <div class="absolute right-0 top-1/2 -translate-y-1/2 h-px w-1.5 bg-cyan/60"></div>
        </div>
        <span class="mono text-[10px] sm:text-xs text-text-dim tracking-[0.4em] uppercase">
          {t(lang, 'skills.tag')}
        </span>
      </div>

      <h2 class="text-4xl sm:text-5xl lg:text-6xl font-sans font-black text-text-primary mb-6">{t(lang, 'skills.title')}</h2>

      <p class="max-w-2xl text-text-secondary text-lg sm:text-xl leading-relaxed font-sans">
        {t(lang, 'skills.description')}
      </p>
    </header>

    <!-- Skills Grid -->
    <div id="skills-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4" data-animate-group>
      {Object.entries(skills).map(([key, category]) => {
        const colors = category.items.map(s => levelColors[s.level] || levelColors.BASIC);
        return (
          <div class="h-full skill-card" data-animate-stagger>
            <!-- GlassContainerValorant replica -->
            <div class="group/card relative overflow-hidden bg-black/60 backdrop-blur-md border border-white/10 transition-all duration-500 hover:border-cyan/40 hover:shadow-[0_0_30px_rgba(0,229,255,0.1)] h-full flex flex-col">
              <!-- Background gradient -->
              <div class="absolute inset-0 bg-gradient-to-br from-white/[0.03] via-transparent to-cyan/[0.02] pointer-events-none"></div>

              <!-- HUD corner decorations (show on hover) -->
              <div class="absolute inset-0 pointer-events-none">
                <div class="absolute top-0 left-0 w-2 h-2 border-t-2 border-l-2 border-cyan opacity-0 transition-opacity duration-300 group-hover/card:opacity-100"></div>
                <div class="absolute bottom-0 right-0 w-2 h-2 border-b-2 border-r-2 border-cyan opacity-0 transition-opacity duration-300 group-hover/card:opacity-100"></div>
                <div class="absolute top-1/2 right-0 w-[1px] h-8 bg-cyan/30 -translate-y-1/2 opacity-0 transition-opacity duration-300 group-hover/card:opacity-100"></div>
                <div class="absolute bottom-1 right-1 mono text-[6px] text-white/10 select-none uppercase tracking-tighter opacity-0 group-hover/card:opacity-100 transition-opacity">PRTC_01//SEC</div>
              </div>

              <!-- Content -->
              <div class="relative z-10 flex flex-col h-full">
                <!-- Card Header -->
                <div class="p-5 border-b border-white/5 bg-white/[0.01]">
                  <div class="flex items-center justify-between mb-1">
                    <h3 class="mono text-xs text-cyan tracking-[0.15em] uppercase">{category.title}</h3>
                    <span class="mono text-[10px] text-text-dim">MK-IV</span>
                  </div>
                  <p class="text-[10px] text-text-dim uppercase tracking-wider">{category.category} MODULE</p>
                </div>

                <!-- Skills List -->
                <div class="p-5 flex-1 space-y-5">
                  {category.items.map((skill, i) => {
                    const c = colors[i];
                    return (
                      <div
                        class="group/item relative skill-item"
                        data-skill-name={skill.name}
                        data-skill-details={skill.details}
                        data-console-target={key}
                      >
                        <!-- Label & Level -->
                        <div class="flex items-center justify-between mb-2">
                          <span class="text-sm font-medium text-text-secondary group-hover/item:text-white transition-colors cursor-default">
                            {skill.name}
                          </span>
                          <span class={`mono text-[9px] px-1.5 py-0.5 rounded border ${c.border} ${c.text} ${c.bg}`}>
                            {skill.level}
                          </span>
                        </div>

                        <!-- Progress Bar -->
                        <div class="h-1.5 w-full bg-white/5 rounded-full overflow-hidden relative">
                          <div
                            class={`skill-progress h-full absolute left-0 top-0 rounded-full ${c.bar}`}
                            data-progress={skill.progress}
                            style="width: 0%"
                          ></div>
                        </div>
                      </div>
                    );
                  })}
                </div>

                <!-- Tactical Console -->
                <div class="p-4 mt-auto border-t border-white/5 bg-black/20 h-[72px] flex items-center overflow-hidden">
                  <p id={`console-${key}`} class="mono text-[10px] uppercase tracking-wide leading-relaxed transition-colors duration-200" data-idle-text={t(lang, 'skills.consoleIdle')} data-detected-text={t(lang, 'skills.consoleDetected')}>
                    <span class="text-text-dim opacity-50">{t(lang, 'skills.consoleIdle')}</span>
                  </p>
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  function initSkills() {
    const grid = document.getElementById('skills-grid');
    if (!grid) return;

    // Progress bar animation on scroll
    const progressBars = grid.querySelectorAll('.skill-progress');
    const barObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const bar = entry.target as HTMLElement;
            const progress = bar.dataset.progress || '0';
            // Small delay for stagger effect
            setTimeout(() => {
              bar.style.transition = 'width 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
              bar.style.width = `${progress}%`;
            }, 100);
            barObserver.unobserve(bar);
          }
        });
      },
      { threshold: 0.1 }
    );
    progressBars.forEach((bar) => barObserver.observe(bar));

    // Hover console effect
    const skillItems = grid.querySelectorAll('.skill-item');
    skillItems.forEach((item) => {
      const el = item as HTMLElement;
      const name = el.dataset.skillName;
      const details = el.dataset.skillDetails;
      const target = el.dataset.consoleTarget;

      el.addEventListener('mouseenter', () => {
        const consoleEl = document.getElementById(`console-${target}`);
        if (consoleEl) {
          const detectedText = consoleEl.dataset.detectedText || '> DETECTED:';
          consoleEl.innerHTML = `<span class="text-cyan">${detectedText}</span> ${name}<br/><span class="text-text-dim">&gt; ${details}</span>`;
        }
      });

      el.addEventListener('mouseleave', () => {
        const consoleEl = document.getElementById(`console-${target}`);
        if (consoleEl) {
          const idleText = consoleEl.dataset.idleText || '> SYSTEM IDLE // AWAITING INPUT...';
          consoleEl.innerHTML = `<span class="text-text-dim opacity-50">${idleText}</span>`;
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initSkills);
</script>
