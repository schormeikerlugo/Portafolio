---
import Base from '../../layouts/Base.astro';
import HudCorners from '../hud/HudCorners.astro';
import { breadcrumbSchema } from '../../lib/seo';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const isEn = lang === 'en';
const messages = {
  sending: t(lang, 'contact.sending'),
  submit: t(lang, 'contact.submitButton'),
  error: t(lang, 'contact.errorSend'),
  errName: t(lang, 'contact.errName'),
  errEmail: t(lang, 'contact.errEmail'),
  errMessage: t(lang, 'contact.errMessage'),
  copied: t(lang, 'contact.copied'),
  copy: t(lang, 'contact.copy'),
};
---

<Base
  lang={lang}
  title="Contact"
  description={t(lang, 'seo.contact.description')}
  keywords={isEn
    ? ['contact', 'hire UI/UX designer', 'freelance frontend developer', 'remote collaboration', 'web quote']
    : ['contacto', 'contratar diseñador UI/UX', 'desarrollador frontend freelance', 'colaboración remota', 'presupuesto web']}
  jsonLd={breadcrumbSchema([
    { name: 'Home', url: 'https://schormeiker.com' },
    { name: 'Contact', url: `https://schormeiker.com${isEn ? '/en' : ''}/contact` },
  ])}
>
  <section class="pt-28 pb-24 px-6 min-h-screen">
    <div class="max-w-[1200px] mx-auto">
      <div class="mb-16 section-header" data-animate>
        <span class="mono text-[11px] text-cyan/60 tracking-[0.2em] uppercase">{t(lang, 'contact.tag')}</span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-sans font-black text-text-primary mt-4">{t(lang, 'contact.title')}</h1>
        <p class="text-text-secondary font-sans text-lg max-w-2xl mt-6 leading-relaxed">
          {t(lang, 'contact.description')}
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <!-- Contact Info -->
        <div class="lg:col-span-4 space-y-8" data-animate>
          <div>
            <span class="mono text-[11px] text-text-dim tracking-widest uppercase">{t(lang, 'contact.emailLabel')}</span>
            <div class="flex items-center gap-3 mt-2">
              <a href="mailto:schormeikerl@gmail.com" class="text-cyan font-sans text-lg hover:text-white transition-colors">schormeikerl@gmail.com</a>
              <button type="button" id="copy-email" data-email="schormeikerl@gmail.com" class="mono text-[11px] uppercase tracking-[0.2em] px-2 py-1 border border-border text-text-dim hover:text-cyan hover:border-cyan/40 transition-colors">{t(lang, 'contact.copy')}</button>
            </div>
          </div>

          <div>
            <span class="mono text-[11px] text-text-dim tracking-widest uppercase">{t(lang, 'contact.socialLabel')}</span>
            <div class="flex flex-col gap-2 mt-2">
              <a href="https://www.linkedin.com/in/schormeiker/" target="_blank" rel="noopener" class="text-text-secondary hover:text-cyan transition-colors font-sans text-sm">LinkedIn ↗</a>
              <a href="https://github.com/schormeikerlugo" target="_blank" rel="noopener" class="text-text-secondary hover:text-cyan transition-colors font-sans text-sm">GitHub ↗</a>
              <a href="https://behance.net/schormeikerlugo" target="_blank" rel="noopener" class="text-text-secondary hover:text-cyan transition-colors font-sans text-sm">Behance ↗</a>
              <a href="https://dribbble.com/schormeiker" target="_blank" rel="noopener" class="text-text-secondary hover:text-cyan transition-colors font-sans text-sm">Dribbble ↗</a>
              <a href="https://instagram.com/schormeiker_lugo" target="_blank" rel="noopener" class="text-text-secondary hover:text-cyan transition-colors font-sans text-sm">Instagram ↗</a>
            </div>
          </div>

          <div>
            <span class="mono text-[11px] text-text-dim tracking-widest uppercase">{t(lang, 'contact.downloadLabel')}</span>
            <a href="/media/CV.pdf" download class="block text-text-secondary hover:text-cyan transition-colors font-sans text-sm mt-2">
              {t(lang, 'contact.downloadCv')}
            </a>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="lg:col-span-8" data-animate>
          <div class="relative border border-border/30 bg-surface/20">
            <HudCorners size={12} color="rgba(255,255,255,0.45)" />
            <!-- Form Header -->
            <div class="px-6 py-3 border-b border-border/30 flex items-center gap-3">
              <div class="flex gap-1.5">
                <div class="w-2.5 h-2.5 rounded-full bg-red-500/60"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-yellow-500/60"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-green-500/60"></div>
              </div>
              <span class="mono text-[11px] text-text-dim">{t(lang, 'contact.formHeader')}</span>
            </div>

            <form id="contact-form" class="p-6 sm:p-8 space-y-6" novalidate>
              <div>
                <label for="f-name" class="mono text-[11px] text-text-dim tracking-widest uppercase block mb-2">{t(lang, 'contact.nameLabel')}</label>
                <input
                  type="text"
                  id="f-name"
                  name="name"
                  aria-describedby="e-name"
                  placeholder={t(lang, 'contact.namePlaceholder')}
                  required
                  class="field w-full bg-void/50 border border-border/30 px-4 py-3 mono text-sm text-text-primary placeholder-text-dim focus:border-cyan/50 focus:outline-none transition-colors"
                />
                <p class="field-error" id="e-name" data-error-for="name"></p>
              </div>

              <div>
                <label for="f-email" class="mono text-[11px] text-text-dim tracking-widest uppercase block mb-2">{t(lang, 'contact.emailFieldLabel')}</label>
                <input
                  type="email"
                  id="f-email"
                  name="email"
                  aria-describedby="e-email"
                  placeholder={t(lang, 'contact.emailPlaceholder')}
                  required
                  class="field w-full bg-void/50 border border-border/30 px-4 py-3 mono text-sm text-text-primary placeholder-text-dim focus:border-cyan/50 focus:outline-none transition-colors"
                />
                <p class="field-error" id="e-email" data-error-for="email"></p>
              </div>

              <div>
                <label for="f-message" class="mono text-[11px] text-text-dim tracking-widest uppercase block mb-2">{t(lang, 'contact.messageLabel')}</label>
                <textarea
                  id="f-message"
                  name="message"
                  aria-describedby="e-message"
                  placeholder={t(lang, 'contact.messagePlaceholder')}
                  rows="6"
                  required
                  maxlength="2000"
                  class="field w-full bg-void/50 border border-border/30 px-4 py-3 mono text-sm text-text-primary placeholder-text-dim focus:border-cyan/50 focus:outline-none transition-colors resize-none"
                ></textarea>
                <div class="flex justify-between gap-4">
                  <p class="field-error" id="e-message" data-error-for="message"></p>
                  <span id="msg-count" class="mono text-[11px] text-text-dim tracking-widest mt-2 shrink-0">0 / 2000</span>
                </div>
              </div>

              <!-- Status message -->
              <div id="form-status" role="status" aria-live="polite" class="hidden mono text-[11px] tracking-widest uppercase text-center py-3"></div>

              <button
                type="submit"
                id="submit-btn"
                class="w-full px-8 py-4 bg-cyan text-void mono text-[11px] tracking-[0.2em] font-bold uppercase btn-primary"
              >
                {t(lang, 'contact.submitButton')}
              </button>
            </form>

            <div id="form-sent" class="hidden p-10 sm:p-14 text-center" tabindex="-1">
              <div class="sent-ring mx-auto mb-8" aria-hidden="true"><span></span></div>
              <p class="mono text-[11px] text-cyan tracking-[0.2em] uppercase">200 // OK</p>
              <h2 class="font-sans font-black text-3xl sm:text-4xl text-text-primary uppercase mt-3">{t(lang, 'contact.sentTitle')}</h2>
              <p class="text-text-secondary font-sans mt-4">{t(lang, 'contact.sentBody')}</p>
              <button type="button" id="send-another" class="mt-8 px-6 py-3 border border-border mono text-[11px] uppercase tracking-[0.2em] text-text-primary hover:border-cyan/50 hover:text-cyan transition-colors">{t(lang, 'contact.sendAnother')}</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script define:vars={{ messages }}>
  window.__contactMessages = messages;
</script>

<script>
  import emailjs from '@emailjs/browser';
  import { onPageLoad } from '../../lib/lifecycle';

  onPageLoad(() => {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const statusEl = document.getElementById('form-status');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const sent = document.getElementById('form-sent');
    const m = (window as any).__contactMessages as Record<string, string>;
    const copyBtn = document.getElementById('copy-email') as HTMLButtonElement | null;

    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copyBtn.dataset.email || '');
        copyBtn.textContent = m.copied;
        setTimeout(() => (copyBtn.textContent = m.copy), 1800);
      } catch { /* clipboard unavailable: mailto link remains */ }
    });

    if (!form || !statusEl || !submitBtn || !sent) return;
    emailjs.init('tBWThKCCfKhzkB3e_');

    const fields = {
      name: form.elements.namedItem('name') as HTMLInputElement,
      email: form.elements.namedItem('email') as HTMLInputElement,
      message: form.elements.namedItem('message') as HTMLTextAreaElement,
    };
    const rules: Record<keyof typeof fields, () => string> = {
      name: () => (fields.name.value.trim().length < 2 ? m.errName : ''),
      email: () => (/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(fields.email.value.trim()) ? '' : m.errEmail),
      message: () => (fields.message.value.trim().length < 20 ? m.errMessage : ''),
    };
    const validate = (key: keyof typeof fields) => {
      const msg = rules[key]();
      const el = form.querySelector(`[data-error-for="${key}"]`);
      if (el) el.textContent = msg;
      fields[key].setAttribute('aria-invalid', String(!!msg));
      return !msg;
    };
    (Object.keys(fields) as (keyof typeof fields)[]).forEach((k) => {
      fields[k].addEventListener('blur', () => fields[k].value && validate(k));
      fields[k].addEventListener('input', () => fields[k].getAttribute('aria-invalid') === 'true' && validate(k));
    });
    const counter = document.getElementById('msg-count');
    fields.message.addEventListener('input', () => {
      if (counter) counter.textContent = `${fields.message.value.length} / 2000`;
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const results = (Object.keys(fields) as (keyof typeof fields)[]).map(validate);
      if (results.includes(false)) {
        const firstBad = (Object.keys(fields) as (keyof typeof fields)[]).find((k, i) => !results[i]);
        if (firstBad) fields[firstBad].focus();
        return;
      }
      submitBtn.disabled = true;
      submitBtn.textContent = m.sending;
      submitBtn.classList.add('is-sending');
      statusEl.classList.add('hidden');
      try {
        await emailjs.sendForm('service_bsa03au', 'template_be9bip7', form);
        form.reset();
        if (counter) counter.textContent = '0 / 2000';
        form.classList.add('hidden');
        sent.classList.remove('hidden');
        sent.focus();
      } catch {
        statusEl.textContent = `✗ ${m.error}`;
        statusEl.className = 'mono text-[11px] tracking-widest uppercase text-center py-3 text-red-400';
      }
      submitBtn.disabled = false;
      submitBtn.textContent = m.submit;
      submitBtn.classList.remove('is-sending');
    });

    document.getElementById('send-another')?.addEventListener('click', () => {
      sent.classList.add('hidden');
      form.classList.remove('hidden');
      fields.name.focus();
    });
  });
</script>
