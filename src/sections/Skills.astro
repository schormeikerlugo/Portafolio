---
import { skills } from '../data/content';
import { t, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;

// Each category gets a unique color
const categoryColors: Record<string, string> = {
  primary: '#00e5ff',   // cyan — frontend
  secondary: '#fbbf24', // amber — backend
  tactical: '#a78bfa',  // purple — tools
  ultimate: '#f87171',  // red — AI
};

const levelColors: Record<string, { bar: string }> = {
  EXPERT:       { bar: '#00e5ff' },
  SPECIALIST:   { bar: '#a78bfa' },
  ADVANCED:     { bar: '#3b82f6' },
  INTERMEDIATE: { bar: '#34d399' },
  BASIC:        { bar: 'rgba(255,255,255,0.3)' },
};
---

<section id="skills" class="relative z-10 py-20 sm:py-24 px-6 bg-void overflow-hidden">
  <div class="max-w-[1400px] mx-auto relative z-10">
    <!-- Header -->
    <header class="skills-header mb-16 section-header flex flex-col items-center md:items-start text-center md:text-left" data-animate>
      <div class="flex items-center gap-4 mb-2">
        <div class="relative w-5 h-5 opacity-60">
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-1 h-1 bg-cyan rounded-full"></div>
          </div>
          <div class="absolute top-0 left-1/2 -translate-x-1/2 w-px h-1.5 bg-cyan/60"></div>
          <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-px h-1.5 bg-cyan/60"></div>
          <div class="absolute left-0 top-1/2 -translate-y-1/2 h-px w-1.5 bg-cyan/60"></div>
          <div class="absolute right-0 top-1/2 -translate-y-1/2 h-px w-1.5 bg-cyan/60"></div>
        </div>
        <span class="mono text-[10px] sm:text-xs text-text-dim tracking-[0.4em] uppercase">
          {t(lang, 'skills.tag')}
        </span>
      </div>

      <h2 class="text-4xl sm:text-5xl lg:text-6xl font-sans font-black text-text-primary mb-6">{t(lang, 'skills.title')}</h2>

      <p class="max-w-2xl text-text-secondary text-lg sm:text-xl leading-relaxed font-sans">
        {t(lang, 'skills.description')}
      </p>
    </header>

    <!-- Skills Grid -->
    <div id="skills-grid" class="grid grid-cols-1 md:grid-cols-2 gap-5" data-animate-group>
      {Object.entries(skills).map(([key, category]) => {
        const catColor = categoryColors[key] || '#00e5ff';
        return (
          <div class="h-full skill-card" data-animate-stagger>
            <div
              class="skill-card-inner group/card relative overflow-hidden bg-black/60 backdrop-blur-md border border-white/8 h-full flex flex-col transition-all duration-500"
              style={`--card-color: ${catColor}`}
            >
              <!-- Background gradient (shifts to card color on hover) -->
              <div class="absolute inset-0 bg-gradient-to-br from-white/[0.02] via-transparent to-transparent pointer-events-none transition-all duration-500 group-hover/card:from-[var(--card-color)]/[0.04] group-hover/card:to-[var(--card-color)]/[0.01]"></div>

              <!-- HUD corners — colored per category -->
              <div class="absolute inset-0 pointer-events-none">
                <div class="absolute top-0 left-0 w-3 h-3 border-t-2 border-l-2 opacity-0 transition-all duration-300 group-hover/card:opacity-100" style={`border-color: ${catColor}`}></div>
                <div class="absolute top-0 right-0 w-3 h-3 border-t-2 border-r-2 opacity-0 transition-all duration-300 group-hover/card:opacity-100" style={`border-color: ${catColor}`}></div>
                <div class="absolute bottom-0 left-0 w-3 h-3 border-b-2 border-l-2 opacity-0 transition-all duration-300 group-hover/card:opacity-100" style={`border-color: ${catColor}`}></div>
                <div class="absolute bottom-0 right-0 w-3 h-3 border-b-2 border-r-2 opacity-0 transition-all duration-300 group-hover/card:opacity-100" style={`border-color: ${catColor}`}></div>
                <!-- Side accent -->
                <div class="absolute top-0 left-0 w-[2px] h-0 group-hover/card:h-full transition-all duration-700" style={`background: ${catColor}40`}></div>
              </div>

              <!-- Content -->
              <div class="relative z-10 flex flex-col h-full">
                <!-- Card Header -->
                <div class="p-5 border-b border-white/5 transition-colors duration-300" style={`background: ${catColor}04`}>
                  <div class="flex items-center justify-between mb-1">
                    <div class="flex items-center gap-3">
                      <div class="w-2 h-2 rounded-full animate-pulse" style={`background: ${catColor}`}></div>
                      <h3 class="mono text-xs tracking-[0.15em] uppercase transition-colors duration-300" style={`color: ${catColor}`}>{category.title}</h3>
                    </div>
                    <span class="mono text-[10px] text-text-dim">MK-IV</span>
                  </div>
                  <p class="text-[10px] text-text-dim uppercase tracking-wider">{category.category} MODULE</p>
                </div>

                <!-- Skills List -->
                <div class="p-5 flex-1 space-y-5">
                  {category.items.map((skill) => {
                    const barColor = levelColors[skill.level]?.bar || 'rgba(255,255,255,0.3)';
                    return (
                      <div
                        class="group/item relative skill-item cursor-default"
                        data-skill-name={skill.name}
                        data-skill-details={skill.details}
                        data-console-target={key}
                        data-skill-color={catColor}
                      >
                        <!-- Label & Level -->
                        <div class="flex items-center justify-between mb-2">
                          <span class="text-sm font-medium text-text-secondary group-hover/item:text-white transition-colors">
                            {skill.name}
                          </span>
                          <span
                            class="mono text-[9px] px-2 py-0.5 rounded border transition-colors duration-200"
                            style={`border-color: ${barColor}40; color: ${barColor}; background: ${barColor}10`}
                          >
                            {skill.level}
                          </span>
                        </div>

                        <!-- Progress Bar -->
                        <div class="h-1.5 w-full bg-white/5 rounded-full overflow-hidden relative">
                          <div
                            class="skill-progress h-full absolute left-0 top-0 rounded-full"
                            data-progress={skill.progress}
                            style={`width: 0%; background: linear-gradient(90deg, ${barColor}60, ${barColor})`}
                          ></div>
                        </div>
                      </div>
                    );
                  })}
                </div>

                <!-- Tactical Console -->
                <div class="p-4 mt-auto border-t border-white/5 h-[72px] flex items-center overflow-hidden transition-colors duration-300" style={`background: ${catColor}05`}>
                  <p
                    id={`console-${key}`}
                    class="mono text-[10px] uppercase tracking-wide leading-relaxed transition-colors duration-200"
                    data-idle-text={t(lang, 'skills.consoleIdle')}
                    data-detected-text={t(lang, 'skills.consoleDetected')}
                    data-color={catColor}
                  >
                    <span class="text-text-dim opacity-50">{t(lang, 'skills.consoleIdle')}</span>
                  </p>
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style is:global>
  .skill-card-inner {
    transition: border-color 0.5s ease, box-shadow 0.5s ease;
  }
  .skill-card-inner:hover {
    border-color: var(--card-color, rgba(0,229,255,0.4)) !important;
    box-shadow: 0 0 30px color-mix(in srgb, var(--card-color, #00e5ff) 15%, transparent),
                inset 0 0 60px color-mix(in srgb, var(--card-color, #00e5ff) 3%, transparent);
  }
</style>

<script>
  function initSkills() {
    const grid = document.getElementById('skills-grid');
    if (!grid) return;

    // Progress bar animation on scroll
    const progressBars = grid.querySelectorAll('.skill-progress');
    const barObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const bar = entry.target as HTMLElement;
            const progress = bar.dataset.progress || '0';
            setTimeout(() => {
              bar.style.transition = 'width 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
              bar.style.width = `${progress}%`;
            }, 100);
            barObserver.unobserve(bar);
          }
        });
      },
      { threshold: 0.1 }
    );
    progressBars.forEach((bar) => barObserver.observe(bar));

    // Hover console effect with category color
    const skillItems = grid.querySelectorAll('.skill-item');
    skillItems.forEach((item) => {
      const el = item as HTMLElement;
      const name = el.dataset.skillName;
      const details = el.dataset.skillDetails;
      const target = el.dataset.consoleTarget;
      const color = el.dataset.skillColor || '#00e5ff';

      el.addEventListener('mouseenter', () => {
        const consoleEl = document.getElementById(`console-${target}`);
        if (consoleEl) {
          const detectedText = consoleEl.dataset.detectedText || '> DETECTED:';
          consoleEl.innerHTML = `<span style="color:${color}">${detectedText}</span> ${name}<br/><span class="text-text-dim">&gt; ${details}</span>`;
        }
      });

      el.addEventListener('mouseleave', () => {
        const consoleEl = document.getElementById(`console-${target}`);
        if (consoleEl) {
          const idleText = consoleEl.dataset.idleText || '> SYSTEM IDLE // AWAITING INPUT...';
          consoleEl.innerHTML = `<span class="text-text-dim opacity-50">${idleText}</span>`;
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initSkills);
</script>
