---
import Base from '../layouts/Base.astro';
import { experience, telemetry, bio } from '../data/content';
import { personSchema, breadcrumbSchema } from '../lib/seo';
import { t, type Lang } from '../i18n';

const lang: Lang = 'es';
---

<Base
  lang="es"
  title="About"
  description="Sobre Schormeiker Lugo — +7 años de experiencia en UI/UX y Frontend. Trayectoria desde diseño visual hasta ingeniería de sistemas interactivos con IA."
  keywords={['sobre mí', 'experiencia', 'UI/UX designer', 'frontend developer', 'trayectoria profesional', 'skills', 'React', 'Figma', 'AI']}
  ogImage="/media/perfil.jpg"
  jsonLd={[personSchema(), breadcrumbSchema([
    { name: 'Home', url: 'https://schormeikerlugo.com' },
    { name: 'About', url: 'https://schormeikerlugo.com/about' },
  ])]}
>
  <!-- ═══ BIO ═══ -->
  <section class="pt-28 pb-24 px-6">
    <div class="max-w-[1400px] mx-auto">
      <div class="mb-16 section-header" data-animate>
        <span class="mono text-[10px] text-cyan/60 tracking-[0.3em] uppercase">{t(lang, 'about.tag')}</span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-sans font-black text-text-primary mt-4">{t(lang, 'about.title')}</h1>
      </div>

      <!-- Stats Bar -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-16" data-animate-group>
        {[
          { ...t(lang, 'about.stats')[0], value: '7', icon: 'M12 8v4l3 3m6-3a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z' },
          { ...t(lang, 'about.stats')[1], value: '34', icon: 'M2 16V4a2 2 0 0 1 2-2h6l2 2h6a2 2 0 0 1 2 2v4M6 12l4 4 4-4M10 16V8' },
          { ...t(lang, 'about.stats')[2], value: '99.9', icon: 'M22 12h-4l-3 9L9 3l-3 9H2' },
          { ...t(lang, 'about.stats')[3], value: '6', icon: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8ZM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75' },
        ].map((stat) => (
          <div class="stat-card group border border-border/30 bg-surface/20 p-6 hover:border-cyan/40 transition-all duration-300 cursor-default" data-animate-stagger data-count-value={stat.value} data-count-suffix={stat.suffix}>
            <div class="flex items-center gap-2 mb-3">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-cyan/50 group-hover:text-cyan transition-colors"><path d={stat.icon}/></svg>
              <span class="mono text-[9px] text-text-dim uppercase tracking-widest group-hover:text-text-secondary transition-colors">{stat.label}</span>
            </div>
            <div class="flex items-baseline gap-1">
              <span class="stat-number mono text-2xl md:text-3xl text-cyan font-bold" data-target={stat.value}>0</span>
              <span class="mono text-sm text-cyan/60 font-bold">{stat.suffix}</span>
            </div>
            <span class="mono text-[9px] text-text-dim mt-1 block uppercase tracking-wider">{stat.unit}</span>
          </div>
        ))}
      </div>

      <!-- Profile + Bio -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mb-24">
        <div class="lg:col-span-4 flex justify-center lg:justify-start" data-animate>
          <div class="relative max-w-[400px] overflow-hidden border border-border/30">
            <img
              src="/media/perfil.jpg"
              alt="Schormeiker Lugo"
              class="w-full h-auto block"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-void/60 to-transparent"></div>
          </div>
        </div>

        <div class="lg:col-span-8 space-y-6 text-center lg:text-left" data-animate>
          {bio.paragraphs.map((p) => (
            <p class="text-text-secondary font-sans text-base sm:text-lg leading-relaxed">{p}</p>
          ))}
          <blockquote class="border-l-2 border-cyan pl-6 mt-8 text-left">
            <p class="text-cyan font-sans text-lg italic">{bio.missionStatement}</p>
          </blockquote>

          <div class="mt-8 flex justify-center lg:justify-start">
          <a href="/media/CV.pdf" download class="inline-flex items-center gap-2 px-5 py-3 bg-cyan text-void mono text-[11px] tracking-[0.2em] font-bold uppercase btn-primary">
            {t(lang, 'about.downloadCv')}
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
          </a>
          </div>
        </div>

      <!-- Evolution Phases -->
      <div class="mb-24">
        <h2 class="text-3xl sm:text-4xl font-sans font-black text-text-primary mb-12 uppercase text-center md:text-left" data-animate>{t(lang, 'about.evolutionTitle')}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-animate-group>
          {bio.phases.map((phase) => (
            <div class="border border-border/30 bg-surface/20 p-8 hover:border-cyan/20 transition-colors" data-animate-stagger>
              <span class="mono text-[10px] text-cyan/60 tracking-widest">{phase.id} //</span>
              <h3 class="text-xl font-sans font-bold text-text-primary mt-2 uppercase">{phase.title}</h3>
              <p class="text-text-secondary font-sans text-sm mt-4 leading-relaxed">{phase.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ EXPERIENCE ═══ -->
  <section class="py-24 px-6 border-t border-border">
    <div class="max-w-[1400px] mx-auto">
      <h2 class="text-3xl sm:text-4xl font-sans font-black text-text-primary mb-12 uppercase text-center md:text-left" data-animate>{t(lang, 'about.timelineTitle')}</h2>

      <div class="space-y-0" data-animate-group>
        {experience.map((job, i) => (
          <div class="border-b border-border/30 py-8 group hover:bg-surface/20 transition-colors px-4" data-animate-stagger>
            <div class="flex flex-col md:flex-row md:items-start gap-4 md:gap-12">
              <div class="md:w-[200px] shrink-0">
                <span class="mono text-[10px] text-cyan uppercase tracking-widest font-bold">
                  {t(lang, 'about.missionPrefix')}{String(i + 1).padStart(2, '0')}
                </span>
                <p class="mono text-[10px] text-text-dim mt-1">{job.period}</p>
              </div>

              <div class="flex-1">
                <h3 class="text-lg font-sans font-bold text-text-primary uppercase">{job.role}</h3>
                <p class="mono text-[10px] text-text-dim mt-1">{job.company}</p>
                <p class="text-text-secondary font-sans text-sm mt-3 leading-relaxed max-w-2xl">{job.description}</p>
                <div class="flex flex-wrap gap-2 mt-4">
                  {job.tech.map((t) => (
                    <span class="mono text-[9px] text-text-dim border border-border/30 px-2 py-0.5 uppercase tracking-wider">{t}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ EDUCACIÓN & CERTIFICACIONES ═══ -->
  <section class="py-24 px-6 border-t border-border">
    <div class="max-w-[1400px] mx-auto">
      <h2 class="text-3xl sm:text-4xl font-sans font-black text-text-primary mb-12 uppercase text-center md:text-left" data-animate>{t(lang, 'about.certsTitle')}</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-animate-group>
        {[
          { title: 'Figma: Técnicas Avanzadas de Diseño', provider: 'Platzi', date: 'Nov. 2023', link: 'https://platzi.com/p/schormeikerlugo/curso/7998-figma-tecnicas-avanzadas/diploma/detalle/' },
          { title: 'Figma: Prototyping and Interfaces', provider: 'Platzi', date: 'Nov. 2023', link: 'https://platzi.com/p/schormeikerlugo/curso/4038-figma-basico/diploma/detalle/' },
          { title: 'Adobe XD Course', provider: 'Platzi', date: 'Nov. 2022', link: 'https://platzi.com/p/schormeikerlugo/curso/2420-adobe-xd/diploma/detalle/' },
          { title: 'Arquitectura de Información con Usaria', provider: 'Platzi', date: 'Nov. 2022', link: 'https://platzi.com/p/schormeikerlugo/curso/1354-arquitectura-informacion/diploma/detalle/' },
          { title: 'Fundamentos de Diseño de Interfaces UI/UX', provider: 'Platzi', date: 'May. 2022', link: 'https://platzi.com/p/schormeikerlugo/curso/1754-diseno-interfaces-ux/diploma/detalle/' },
          { title: 'Introducción al Diseño', provider: 'Platzi', date: 'Dic. 2021', link: 'https://platzi.com/p/schormeikerlugo/curso/1228-fundamentos-diseno/diploma/detalle/' },
          { title: 'Matte Painting: Complete Techniques', provider: 'Udemy', date: 'Nov. 2016', link: 'https://www.udemy.com/certificate/UC-JSLCGQQ9/' },
        ].map((cert, i) => (
          <a href={cert.link || undefined} target={cert.link ? '_blank' : undefined} rel={cert.link ? 'noopener' : undefined} class:list={['group flex items-start gap-5 border border-border/30 bg-surface/20 p-6 hover:border-cyan/30 transition-colors', cert.link ? 'cursor-pointer' : 'cursor-default']} data-animate-stagger>
            <div class="w-10 h-10 shrink-0 border border-cyan/20 bg-cyan/5 flex items-center justify-center">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-cyan/60 group-hover:text-cyan transition-colors">
                <circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>
              </svg>
            </div>
            <div class="flex-1">
              <h3 class="font-sans text-sm sm:text-base text-text-primary font-semibold group-hover:text-cyan transition-colors">{cert.title}</h3>
              <div class="flex items-center gap-3 mt-2">
                <span class="mono text-[9px] text-cyan/60 uppercase tracking-wider">{cert.provider}</span>
                <span class="text-text-dim mono text-[8px]">//</span>
                <span class="mono text-[9px] text-text-dim uppercase tracking-wider">{cert.date}</span>
              </div>
            </div>
            {cert.link && (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-text-dim group-hover:text-cyan group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all shrink-0 mt-1"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ TELEMETRY ═══ -->
  <section class="py-24 px-6 border-t border-border">
    <div class="max-w-[1400px] mx-auto">
      <h2 class="text-3xl sm:text-4xl font-sans font-black text-text-primary mb-12 uppercase text-center md:text-left" data-animate>{t(lang, 'about.telemetryTitle')}</h2>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4" data-animate-group>
        {telemetry.map((item) => (
          <div class="border border-border/30 bg-surface/20 p-6" data-animate-stagger>
            <span class="mono text-[9px] text-text-dim uppercase tracking-widest">{item.label}</span>
            <p class="mono text-xs text-cyan mt-2 font-bold">{item.value}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  function initCounters() {
    const counters = document.querySelectorAll('.stat-number');
    if (!counters.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const target = parseFloat(el.dataset.target || '0');
            const isDecimal = target % 1 !== 0;
            const duration = 1200;
            const start = performance.now();

            function update(now: number) {
              const elapsed = now - start;
              const progress = Math.min(elapsed / duration, 1);
              // ease-out cubic
              const eased = 1 - Math.pow(1 - progress, 3);
              const current = eased * target;

              el.textContent = isDecimal ? current.toFixed(1) : Math.floor(current).toString();

              if (progress < 1) {
                requestAnimationFrame(update);
              } else {
                el.textContent = isDecimal ? target.toFixed(1) : target.toString();
              }
            }

            requestAnimationFrame(update);
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.3 }
    );

    counters.forEach((el) => observer.observe(el));
  }

  document.addEventListener('astro:page-load', initCounters);
</script>
