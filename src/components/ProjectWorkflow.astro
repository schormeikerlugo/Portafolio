---
import { getWorkflow } from '../data/workflows';
import { type Lang } from '../i18n';

interface Props {
  projectId: number;
  lang?: Lang;
}

const { projectId, lang = 'es' } = Astro.props;
const workflow = getWorkflow(projectId);
if (!workflow) return;

const isEn = lang === 'en';
const steps = workflow.steps;
const decision = workflow.decision;
const topRow = steps.slice(0, 4); // First 4 steps + decision on top
const bottomRow = steps.slice(4).reverse(); // Last 4 steps reversed on bottom
const sectionLabel = isEn ? 'WORKFLOW' : 'PROCESO DE TRABAJO';
const expandLabel = isEn ? '[ VIEW FULL PROCESS ]' : '[ VER PROCESO COMPLETO ]';
const collapseLabel = isEn ? '[ COLLAPSE ]' : '[ COLAPSAR ]';
---

{workflow && (
<div class="mb-16" data-animate>
  <span class="mono text-[10px] text-cyan/60 tracking-widest uppercase">{sectionLabel}</span>

  <!-- Mobile: collapsed view (first 4 steps as vertical list) -->
  <div class="wf-mobile-preview md:hidden mt-6">
    <div class="space-y-0">
      {steps.slice(0, 4).map((step, i) => (
        <div class="wf-mobile-step flex items-start gap-4 py-4 border-b border-border/20" data-animate-stagger>
          <div class="wf-mobile-dot shrink-0 mt-1">
            <div class:list={['w-8 h-8 flex items-center justify-center border text-center', step.accent ? 'border-cyan/30 bg-cyan/5' : 'border-border/30 bg-surface/30']}>
              <span class="mono text-[9px] text-cyan font-bold">{String(i + 1).padStart(2, '0')}</span>
            </div>
          </div>
          <div class="flex-1 min-w-0">
            <span class="mono text-[7px] text-cyan/50 uppercase tracking-widest">{isEn ? step.labelEn : step.label}</span>
            <h4 class="font-sans text-sm font-bold text-text-primary uppercase mt-0.5">{isEn ? step.titleEn : step.title}</h4>
            <p class="mono text-[8px] text-text-dim mt-1">{isEn ? step.subEn : step.sub}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Expand button -->
    <button class="wf-expand-btn w-full mt-4 py-3 border border-border/30 mono text-[10px] text-text-dim hover:text-cyan hover:border-cyan/30 uppercase tracking-widest transition-colors cursor-pointer text-center" data-expand-label={expandLabel} data-collapse-label={collapseLabel}>
      {expandLabel}
    </button>

    <!-- Hidden full mobile list -->
    <div class="wf-mobile-full hidden">
      <div class="space-y-0 mt-4">
        {steps.slice(4).map((step, i) => (
          <div class="wf-mobile-step flex items-start gap-4 py-4 border-b border-border/20">
            <div class="wf-mobile-dot shrink-0 mt-1">
              <div class:list={['w-8 h-8 flex items-center justify-center border text-center', step.accent ? 'border-cyan/30 bg-cyan/5' : 'border-border/30 bg-surface/30']}>
                <span class="mono text-[9px] text-cyan font-bold">{String(i + 5).padStart(2, '0')}</span>
              </div>
            </div>
            <div class="flex-1 min-w-0">
              <span class="mono text-[7px] text-cyan/50 uppercase tracking-widest">{isEn ? step.labelEn : step.label}</span>
              <h4 class="font-sans text-sm font-bold text-text-primary uppercase mt-0.5">{isEn ? step.titleEn : step.title}</h4>
              <p class="mono text-[8px] text-text-dim mt-1">{isEn ? step.subEn : step.sub}</p>
            </div>
          </div>
        ))}
      </div>

      {decision && (
        <div class="mt-4 p-4 border border-dashed border-border/30 bg-surface/20 flex items-center gap-4">
          <div class="w-10 h-10 border border-white/12 bg-white/4 flex items-center justify-center shrink-0" style="transform: rotate(45deg)">
            <span class="mono text-[7px] text-text-primary uppercase" style="transform: rotate(-45deg)">{isEn ? decision.labelEn : decision.label}</span>
          </div>
          <div class="flex-1">
            <div class="flex items-center gap-3">
              <span class="mono text-[8px] text-cyan">{isEn ? decision.yesEn : decision.yes} → {isEn ? 'Continue' : 'Continuar'}</span>
              <span class="mono text-[8px] text-red-400/60">{isEn ? decision.noEn : decision.no} → {isEn ? (workflow.iterateLabelEn || 'Iterate') : (workflow.iterateLabel || 'Iterar')}</span>
            </div>
          </div>
        </div>
      )}
    </div>
  </div>

  <!-- Desktop: full flowchart -->
  <div class="wf-scroll hidden md:block mt-6">
    <div class="wf-stage">
      <!-- Top row: steps 1-4 + decision -->
      <div class="wf-row">
        {topRow.map((step, i) => (
          <Fragment>
            <div class:list={['wf-node', step.accent && 'wf-node-accent']} data-wf-delay={i * 2}>
              <div class="wf-node-label">{isEn ? step.labelEn : step.label}</div>
              <div class="wf-node-title">{isEn ? step.titleEn : step.title}</div>
              <div class="wf-node-sub">{isEn ? step.subEn : step.sub}</div>
            </div>
            {i < topRow.length - 1 && <div class="wf-connector" data-wf-delay={i * 2 + 1}></div>}
          </Fragment>
        ))}

        {decision && (
          <Fragment>
            <div class="wf-connector" data-wf-delay={7}></div>
            <div class="wf-decision" data-wf-delay={8}>
              <div class="wf-decision-inner">
                <span>{isEn ? decision.labelEn : decision.label}</span>
              </div>
            </div>
            <div class="wf-connector" data-wf-delay={9}>
              <span class="wf-yes-label">{isEn ? decision.yesEn : decision.yes}</span>
            </div>
          </Fragment>
        )}
      </div>

      <!-- Bottom row: steps 8-5 (reversed) + iterate -->
      <div class="wf-row wf-row-bottom">
        {decision && (
          <div class="wf-iterate" data-wf-delay={16}>
            <div class="wf-iterate-label">{isEn ? (workflow.iterateLabelEn || 'ITERATE') : (workflow.iterateLabel || 'ITERAR')}</div>
            <div class="wf-iterate-sub">{isEn ? (workflow.iterateSubEn || '') : (workflow.iterateSub || '')}</div>
          </div>
        )}

        {bottomRow.map((step, i) => (
          <Fragment>
            {i > 0 && <div class="wf-connector" data-wf-delay={14 - i}></div>}
            <div class:list={['wf-node', step.accent && 'wf-node-accent']} data-wf-delay={13 - i}>
              <div class="wf-node-label">{isEn ? step.labelEn : step.label}</div>
              <div class="wf-node-title">{isEn ? step.titleEn : step.title}</div>
              <div class="wf-node-sub">{isEn ? step.subEn : step.sub}</div>
            </div>
          </Fragment>
        ))}
      </div>

      <!-- Vertical connector between rows (right side) -->
      <div class="wf-connector-vertical" data-wf-delay={10}></div>

      <!-- No/iterate connector -->
      {decision && (
        <div class="wf-connector-no" data-wf-delay={15}>
          <span class="wf-no-label">{isEn ? decision.noEn : decision.no}</span>
        </div>
      )}
    </div>
  </div>
</div>
)}

<script>
  function initWorkflows() {
    // Desktop: IntersectionObserver for animation
    document.querySelectorAll('.wf-stage').forEach((stage) => {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            stage.classList.add('wf-active');
            observer.disconnect();
          }
        },
        { threshold: 0.15 }
      );
      observer.observe(stage);
    });

    // Mobile: expand/collapse
    document.querySelectorAll('.wf-expand-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const container = btn.closest('.wf-mobile-preview');
        const fullList = container?.querySelector('.wf-mobile-full');
        if (!fullList) return;

        const el = fullList as HTMLElement;
        const isHidden = el.classList.contains('hidden');
        const expandLabel = (btn as HTMLElement).dataset.expandLabel || '';
        const collapseLabel = (btn as HTMLElement).dataset.collapseLabel || '';

        if (isHidden) {
          el.classList.remove('hidden');
          el.style.animation = 'workflowExpand 0.4s ease forwards';
          btn.textContent = collapseLabel;
        } else {
          el.style.animation = 'workflowCollapse 0.3s ease forwards';
          setTimeout(() => {
            el.classList.add('hidden');
            el.style.animation = '';
          }, 300);
          btn.textContent = expandLabel;
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initWorkflows);
</script>
