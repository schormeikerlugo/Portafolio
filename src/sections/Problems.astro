---
import { anomalies } from '../data/content';
import { t, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const items = lang === 'en' ? t(lang, 'problems.items') : anomalies;
---

<section data-section class="py-24 lg:py-32 px-6 border-t border-border">
  <div class="max-w-[1400px] mx-auto">
    <div class="mb-16 section-header" data-animate>
      <span class="mono text-[11px] text-cyan tracking-[0.2em] uppercase">{t(lang, 'problems.tag')}</span>
      <h2 class="text-4xl sm:text-5xl lg:text-6xl font-sans font-black text-text-primary mt-4">{t(lang, 'problems.title')}</h2>
      <p class="text-text-secondary font-sans text-lg max-w-2xl mt-6 leading-relaxed">{t(lang, 'problems.description')}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-animate-group>
      {items.map((anomaly: { code: string; title: string; impact: string; description: string }) => (
        <div class="problem-card-home border border-border/50 bg-surface/30 p-8 group" data-animate-stagger>
          <div class="flex items-center gap-2 mb-3">
            <div class="w-2 h-2 bg-red-400 rounded-full animate-pulse"></div>
            <span class="error-code mono text-[11px] text-red-400/80 tracking-widest uppercase">{anomaly.code}</span>
          </div>
          <h3 class="text-xl font-sans font-bold text-text-primary mt-2 uppercase">{anomaly.title}</h3>
          <p class="mono text-[11px] text-text-dim mt-2">{t(lang, 'problems.impactLabel')} {anomaly.impact}</p>
          <p class="text-text-secondary font-sans text-sm mt-4 leading-relaxed">{anomaly.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
