---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProjectWorkflow from '../ProjectWorkflow.astro';
import { projectSchema, breadcrumbSchema } from '../../lib/seo';
import { getProjects, label, projectUrl, type Project } from '../../lib/projects';
import { t, type Lang } from '../../i18n';

interface Props {
  slug: string;
  lang: Lang;
}

const { slug, lang } = Astro.props;
const isEn = lang === 'en';
const all = await getProjects(lang);
const index = all.findIndex((p) => p.slug === slug);
const project = all[index] as Project;
const prev = all[index - 1];
const next = all[index + 1];
const related = all
  .filter((p) => p.slug !== slug && p.category === project.category)
  .sort((a, b) => Number(b.subcategory === project.subcategory) - Number(a.subcategory === project.subcategory))
  .slice(0, 3);

const og = await getImage({ src: project.cover, width: 1200, format: 'jpg' });
const base = isEn ? '/en' : '';
const pageUrl = `https://schormeiker.com${projectUrl(slug, lang)}`;

const terminal = [
  `> ${slug}@mission-control:~$ scan --brief`,
  '',
  ...project.challenge.flatMap((line, i) => [`[${String(i + 1).padStart(2, '0')}] ${line}`, '']),
].join('\n').trim();

const links = [
  project.links.live && { href: project.links.live, label: t(lang, 'portfolio.visitSite'), primary: true },
  project.links.repo && { href: project.links.repo, label: t(lang, 'portfolio.viewRepo') },
  project.links.behance && { href: project.links.behance, label: t(lang, 'portfolio.viewBehance') },
  project.links.dribbble && { href: project.links.dribbble, label: t(lang, 'portfolio.viewDribbble') },
].filter(Boolean) as { href: string; label: string; primary?: boolean }[];

const facts = [
  { label: t(lang, 'portfolio.yearLabel'), value: String(project.year) },
  { label: t(lang, 'portfolio.typeLabel'), value: label('type', project.type, lang) },
  { label: t(lang, 'portfolio.statusLabel'), value: label('status', project.status, lang) },
  { label: t(lang, 'portfolio.categoryLabel'), value: `${label('category', project.category, lang)} — ${label('subcategory', project.subcategory, lang)}` },
];
---

<Base
  lang={lang}
  title={project.title}
  description={project.summary}
  keywords={[...project.stack, project.title, isEn ? 'case study' : 'caso de estudio']}
  ogImage={og.src}
  jsonLd={[
    projectSchema({ title: project.title, summary: project.summary, url: pageUrl, image: og.src, keywords: project.stack, year: project.year }),
    breadcrumbSchema([
      { name: 'Home', url: 'https://schormeiker.com' },
      { name: 'Work', url: `https://schormeiker.com${base}/work` },
      { name: project.title, url: pageUrl },
    ]),
  ]}
>
  <section class="pt-28 pb-24 px-6">
    <div class="max-w-[1200px] mx-auto">
      <a href={`${base}/work`} class="inline-flex items-center gap-2 mono text-[11px] text-text-dim hover:text-cyan transition-colors uppercase tracking-widest mb-12" data-animate>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        {t(lang, 'portfolio.backButton')}
      </a>

      <!-- Header -->
      <header class="mb-12" data-animate>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-4">
          <span class="mono text-[11px] text-cyan uppercase tracking-[0.2em] font-bold">{project.year}</span>
          <span class="text-text-dim mono text-[11px]">//</span>
          <span class="mono text-[11px] text-text-secondary uppercase tracking-[0.2em]">{label('subcategory', project.subcategory, lang)}</span>
          <span class="text-text-dim mono text-[11px]">//</span>
          <span class="mono text-[11px] text-text-secondary uppercase tracking-[0.2em]">{label('type', project.type, lang)}</span>
          <span class="project-status mono text-[11px] uppercase tracking-[0.2em] px-2 py-0.5 border" data-status={project.status}>{label('status', project.status, lang)}</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-7xl font-sans font-black text-text-primary tracking-tight uppercase" transition:name={`title-${slug}`}>{project.title}</h1>
        <p class="mono text-xs sm:text-sm text-text-secondary uppercase tracking-[0.2em] mt-4">{project.tagline}</p>

        {links.length > 0 && (
          <div class="flex flex-wrap gap-4 mt-8">
            {links.map((l) => (
              <a
                href={l.href}
                target="_blank"
                rel="noopener"
                class:list={[
                  'inline-flex items-center gap-2 px-6 py-3 mono text-[11px] tracking-[0.2em] uppercase',
                  l.primary ? 'bg-cyan text-void font-bold btn-primary' : 'border border-border text-text-primary btn-secondary',
                ]}
              >
                {l.label} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        )}
      </header>

      <!-- Cover -->
      <div class="relative aspect-video w-full overflow-hidden border border-border/30 mb-16" transition:name={`cover-${slug}`}>
        <Image
          src={project.cover}
          alt={project.title}
          widths={[640, 1200, 1600]}
          sizes="(min-width: 1200px) 1200px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="w-full h-full object-cover object-top"
        />
      </div>

      <!-- Overview + facts -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 mb-16">
        <div class="lg:col-span-2" data-animate>
          <span class="mono text-[11px] text-cyan/60 tracking-widest uppercase">{t(lang, 'portfolio.overviewLabel')}</span>
          <p class="text-text-secondary font-sans text-lg leading-relaxed mt-4">{project.summary}</p>
        </div>

        <aside class="space-y-6" data-animate>
          <dl class="grid grid-cols-2 gap-x-6 gap-y-5">
            {facts.map((f) => (
              <div>
                <dt class="mono text-[11px] text-text-dim tracking-widest uppercase">{f.label}</dt>
                <dd class="text-text-primary font-sans mt-1">{f.value}</dd>
              </div>
            ))}
          </dl>
          {project.role.length > 0 && (
            <div>
              <span class="mono text-[11px] text-text-dim tracking-widest uppercase">{t(lang, 'portfolio.roleLabel')}</span>
              <div class="flex flex-wrap gap-2 mt-2">
                {project.role.map((r) => (
                  <span class="mono text-[11px] px-3 py-1.5 border border-cyan/20 text-cyan bg-cyan/5 uppercase tracking-wider">{r}</span>
                ))}
              </div>
            </div>
          )}
          <div>
            <span class="mono text-[11px] text-text-dim tracking-widest uppercase">{t(lang, 'portfolio.stackLabel')}</span>
            <div class="flex flex-wrap gap-2 mt-2">
              {project.stack.map((s) => (
                <span class="mono text-[11px] text-text-dim border border-border/50 px-3 py-1 uppercase tracking-wider">{s}</span>
              ))}
            </div>
          </div>
        </aside>
      </div>

      <!-- Challenge (terminal) -->
      <div class="mb-16 terminal-diag border border-border/30 bg-surface/20 overflow-hidden" data-animate>
        <div class="px-6 py-3 border-b border-border/20 flex items-center gap-3">
          <div class="flex gap-1.5" aria-hidden="true">
            <div class="w-2 h-2 rounded-full bg-red-500/60 animate-pulse"></div>
            <div class="w-2 h-2 rounded-full bg-yellow-500/40"></div>
            <div class="w-2 h-2 rounded-full bg-white/10"></div>
          </div>
          <span class="mono text-[11px] text-red-400/85 tracking-widest uppercase">{t(lang, 'portfolio.challengeLabel')}</span>
        </div>
        <div class="p-6 sm:p-8">
          <pre class="terminal-text mono text-xs sm:text-sm text-text-secondary whitespace-pre-wrap leading-relaxed overflow-x-auto" data-terminal-text={terminal}>{terminal}</pre>
          <span class="terminal-cursor mono text-red-400" aria-hidden="true">_</span>
        </div>
      </div>

      <!-- Approach -->
      <div class="mb-16" data-animate>
        <span class="mono text-[11px] text-cyan/60 tracking-widest uppercase">{t(lang, 'portfolio.approachLabel')}</span>
        <p class="text-text-secondary font-sans text-lg leading-relaxed mt-4">{project.approach}</p>
      </div>

      {project.outcome && (
        <div class="mb-16" data-animate>
          <span class="mono text-[11px] text-cyan/60 tracking-widest uppercase">{t(lang, 'portfolio.outcomeLabel')}</span>
          <p class="text-text-secondary font-sans text-lg leading-relaxed mt-4">{project.outcome}</p>
        </div>
      )}

      <ProjectWorkflow workflow={project.workflow} lang={lang} />

      {project.gallery.length > 0 && (
        <div class="mb-16" data-animate>
          <span class="mono text-[11px] text-cyan/60 tracking-widest uppercase mb-6 block">{t(lang, 'portfolio.galleryLabel')}</span>
          <div class="grid grid-cols-1 gap-4">
            {project.gallery.map((img, i) => (
              <a href={img.src} target="_blank" rel="noopener" class="relative block overflow-hidden border border-border/30">
                <Image
                  src={img}
                  alt={`${project.title} — ${isEn ? 'screen' : 'pantalla'} ${i + 1}`}
                  widths={[640, 1200, 1600]}
                  sizes="(min-width: 1200px) 1200px, 100vw"
                  loading="lazy"
                  class="w-full h-auto"
                />
              </a>
            ))}
          </div>
        </div>
      )}

      {related.length > 0 && (
        <div class="mb-16" data-animate>
          <span class="mono text-[11px] text-cyan/60 tracking-widest uppercase mb-6 block">{t(lang, 'portfolio.related')}</span>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {related.map((r) => (
              <a href={projectUrl(r.slug, lang)} class="group border border-border/50 bg-surface/20 block">
                <div class="aspect-video overflow-hidden">
                  <Image src={r.cover} alt={r.title} widths={[400, 640]} sizes="(min-width: 768px) 33vw, 100vw" loading="lazy" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700" />
                </div>
                <div class="p-4">
                  <span class="mono text-[11px] text-cyan uppercase tracking-widest">{label('subcategory', r.subcategory, lang)} · {r.year}</span>
                  <h3 class="text-lg font-sans font-bold text-text-primary mt-1 uppercase group-hover:text-cyan transition-colors">{r.title}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <nav class="flex items-center justify-between gap-4 pt-12 border-t border-border" data-animate aria-label={isEn ? 'Project navigation' : 'Navegación entre proyectos'}>
        {prev ? (
          <a href={projectUrl(prev.slug, lang)} class="group flex items-center gap-3 text-text-dim hover:text-cyan transition-colors">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
            <div>
              <span class="mono text-[11px] uppercase tracking-widest block">{t(lang, 'portfolio.prev')}</span>
              <span class="font-sans text-sm font-bold uppercase group-hover:text-cyan transition-colors">{prev.title}</span>
            </div>
          </a>
        ) : <div />}

        <a href={`${base}/work`} class="mono text-[11px] text-text-dim hover:text-cyan transition-colors uppercase tracking-widest">{t(lang, 'portfolio.all')}</a>

        {next ? (
          <a href={projectUrl(next.slug, lang)} class="group flex items-center gap-3 text-text-dim hover:text-cyan transition-colors text-right">
            <div>
              <span class="mono text-[11px] uppercase tracking-widest block">{t(lang, 'portfolio.next')}</span>
              <span class="font-sans text-sm font-bold uppercase group-hover:text-cyan transition-colors">{next.title}</span>
            </div>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </a>
        ) : <div />}
      </nav>
    </div>
  </section>
</Base>
