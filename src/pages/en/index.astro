---
import Base from '../../layouts/Base.astro';
import CipherText from '../../components/CipherText.astro';
import MatrixRain from '../../components/react/MatrixRain';
import Skills from '../../sections/Skills.astro';
import Process from '../../sections/Process.astro';
import { projects } from '../../data/content';
import { articles } from '../../data/articles';
import { personSchema, organizationSchema, websiteSchema, breadcrumbSchema, siteNavigationSchema } from '../../lib/seo';
import { t, type Lang } from '../../i18n';

const lang: Lang = 'en';
const shuffled = [...projects].sort(() => Math.random() - 0.5);
const featuredProjects = shuffled.slice(0, 6);
---

<Base
  lang="en"
  title="Home"
  description={t(lang, 'seo.home.description')}
  keywords={['UI/UX designer', 'frontend developer', 'React developer', 'Design Systems', 'Astro', 'portfolio', 'remote', 'freelance']}
  jsonLd={[personSchema(), organizationSchema(), websiteSchema(), siteNavigationSchema(lang), breadcrumbSchema([{ name: 'Home', url: 'https://schormeikerlugo.com' }])]}
>
  <!-- ═══ HERO ═══ -->
  <section id="hero" class="relative min-h-screen flex items-center px-6 z-10 bg-transparent overflow-hidden">
    <!-- Matrix Rain (React Island) -->
    <div class="absolute inset-0 pointer-events-none z-0">
      <MatrixRain opacity={0.35} client:visible />
    </div>

    <!-- Backdrop blur -->
    <div id="hero-backdrop" class="absolute inset-0 pointer-events-none z-[1] hero-backdrop opacity-0 transition-opacity duration-1000"></div>

    <!-- Vertical Labels (desktop) -->
    <div class="absolute top-0 bottom-0 left-2 md:left-4 lg:left-6 z-20 pointer-events-none hidden md:flex items-center hero-element" data-hero-delay="2800">
      <div class="flex items-center gap-3" style="writing-mode: vertical-rl; text-orientation: mixed; transform: rotate(180deg)">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan shadow-[0_0_6px_rgba(0,229,255,0.6)] animate-pulse"></span>
        <span class="mono text-[10px] text-cyan/40 tracking-[0.5em] uppercase font-bold whitespace-nowrap">
          {t(lang, 'hero.leftLabel')}
        </span>
        <span class="block w-px h-16 bg-gradient-to-b from-cyan/30 to-transparent" style="writing-mode: horizontal-tb"></span>
      </div>
    </div>

    <div class="absolute top-0 bottom-0 right-2 md:right-4 lg:right-6 z-20 pointer-events-none hidden md:flex items-center hero-element" data-hero-delay="2800">
      <div class="flex items-center gap-3" style="writing-mode: vertical-rl; text-orientation: mixed">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan shadow-[0_0_6px_rgba(0,229,255,0.6)] animate-pulse"></span>
        <span class="mono text-[10px] text-cyan/40 tracking-[0.5em] uppercase font-bold whitespace-nowrap">
          {t(lang, 'hero.rightLabel')}
        </span>
        <span class="block w-px h-16 bg-gradient-to-b from-cyan/30 to-transparent" style="writing-mode: horizontal-tb"></span>
      </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-[1400px] mx-auto w-full flex flex-col items-center justify-center text-center relative z-10 px-4">
      <div class="flex flex-col items-center w-full">
        <div class="mono text-xs tracking-[0.2em] text-cyan mb-6 hero-element" data-hero-delay="1200">
          {t(lang, 'hero.include')}
        </div>

        <div class="min-h-[100px] sm:min-h-[120px] md:min-h-[140px] flex items-center justify-center w-full hero-element" data-hero-delay="1500">
          <h1 class="relative text-[clamp(1.5rem,8vw,6rem)] font-sans text-text-primary font-bold leading-none tracking-tighter mix-blend-plus-lighter whitespace-nowrap">
            <CipherText text="Schormeiker Lugo" delay={1.8} duration={1.0} />
          </h1>
        </div>

        <h2 class="text-base sm:text-lg mono text-text-secondary uppercase tracking-widest mb-8 hero-element" data-hero-delay="2200">
          {t(lang, 'hero.subtitle')}
        </h2>

        <p class="font-sans text-base sm:text-xl text-text-secondary max-w-2xl leading-relaxed mb-12 mx-auto hero-element" data-hero-delay="2500">
          {t(lang, 'hero.description')}
        </p>

        <div class="flex flex-wrap items-center justify-center gap-6 hero-element" data-hero-delay="2800">
          <a href="/en/about" class="px-8 py-3 bg-cyan text-void mono text-[11px] tracking-[0.2em] font-bold uppercase btn-primary">
            {t(lang, 'hero.cta1')}
          </a>
          <a href="/en/work" class="px-8 py-3 border border-border text-text-primary mono text-[11px] tracking-[0.2em] uppercase btn-secondary">
            {t(lang, 'hero.cta2')}
          </a>
          <a href="/media/CV.pdf" download class="flex items-center gap-2 px-4 py-3 border border-border text-text-primary mono text-[11px] tracking-[0.2em] uppercase btn-secondary">
            {t(lang, 'hero.cv')} <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg> ]
          </a>
        </div>
      </div>
    </div>

    <!-- Chevron -->
    <div class="absolute bottom-12 left-1/2 -translate-x-1/2 z-20 hero-element" data-hero-delay="3200">
      <div class="flex flex-col items-center gap-1 animate-chevron-pulse">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-cyan/40"><polyline points="6 9 12 15 18 9"/></svg>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-cyan/20"><polyline points="6 9 12 15 18 9"/></svg>
      </div>
    </div>

    <div class="absolute bottom-0 left-0 w-full h-32 bg-gradient-to-t from-void to-transparent pointer-events-none z-10"></div>
  </section>

  <!-- ═══ 0X01 TRABAJO SELECCIONADO ═══ -->
  <section class="py-24 lg:py-32 px-6">
    <div class="max-w-[1400px] mx-auto">
      <div class="mb-16 section-header" data-animate>
        <span class="mono text-[10px] text-cyan/60 tracking-[0.3em] uppercase">{t(lang, 'featured.tag')}</span>
        <h2 class="text-4xl sm:text-5xl lg:text-6xl font-sans font-black text-text-primary mt-4">{t(lang, 'featured.title')}</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-animate-group>
        {featuredProjects.map((project) => {
          const tr = t(lang, 'projects')?.[project.id] || {};
          return (
          <a href={`/en/portfolio/${project.id}`} class="featured-card group border border-border/50 bg-surface/20" data-animate-stagger>
            <div class="relative aspect-video overflow-hidden">
              <span class="featured-id font-sans text-white">{String(project.id).padStart(2, '0')}</span>
              <img
                src={project.image}
                alt={project.title}
                loading="lazy"
                class="w-full h-full object-cover object-top grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-110 transition-all duration-700"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-void/80 to-transparent"></div>
              <div class="absolute bottom-4 left-4 right-4">
                <span class="mono text-[9px] text-cyan uppercase tracking-widest">{tr.subcategory || project.subcategory}</span>
                <h3 class="text-xl font-sans font-bold text-white mt-1 uppercase group-hover:text-cyan transition-colors">{project.title}</h3>
              </div>
            </div>
            <div class="p-6">
              <p class="text-text-secondary font-sans text-sm leading-relaxed line-clamp-2">{tr.solution || project.solution}</p>
              <div class="flex flex-wrap gap-2 mt-4">
                {project.tags.slice(0, 3).map((tag) => (
                  <span class="mono text-[9px] text-text-dim border border-border/50 px-2 py-1 uppercase tracking-wider">{tag}</span>
                ))}
              </div>
            </div>
          </a>);
        })}
      </div>

      <div class="mt-12 text-center" data-animate>
        <a href="/en/work" class="inline-block px-8 py-3 border border-border text-text-primary mono text-[11px] tracking-[0.2em] uppercase btn-secondary">
          {t(lang, 'featured.viewAll')}
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ 0X02 SERVICIOS ═══ -->
  <section class="py-24 lg:py-32 px-6 border-t border-border">
    <div class="max-w-[1400px] mx-auto">
      <div class="mb-16 section-header" data-animate>
        <span class="mono text-[10px] text-cyan/60 tracking-[0.3em] uppercase">{t(lang, 'services.tag')}</span>
        <h2 class="text-4xl sm:text-5xl lg:text-6xl font-sans font-black text-text-primary mt-4">{t(lang, 'services.title')}</h2>
        <p class="text-text-secondary font-sans text-lg max-w-2xl mt-6 leading-relaxed">
          {t(lang, 'services.description')}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6" data-animate-group>
        {t(lang, 'services.protocols').map((protocol) => (
          <div class="border border-border/50 bg-surface/20 p-8 hover:border-cyan/30 transition-colors group" data-animate-stagger>
            <span class="mono text-[10px] text-cyan/60 tracking-widest">PROTOCOL {protocol.id}</span>
            <h3 class="text-lg font-sans font-bold text-text-primary mt-3 uppercase group-hover:text-cyan transition-colors">{protocol.title}</h3>
            <p class="mono text-[9px] text-text-dim mt-1 uppercase tracking-wider">{protocol.subtitle}</p>
            <p class="text-text-secondary font-sans text-sm mt-4 leading-relaxed">{protocol.description}</p>
          </div>
        ))}
      </div>

      <div class="mt-12 text-center" data-animate>
        <a href="/en/services" class="inline-block px-8 py-3 border border-border text-text-primary mono text-[11px] tracking-[0.2em] uppercase btn-secondary">
          {t(lang, 'services.viewAll')}
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ 0X03 CÓMO TRABAJO ═══ -->
  <Process lang={lang} />

  <!-- ═══ 0X04 PROBLEMAS QUE RESUELVO ═══ -->
  <section class="py-24 lg:py-32 px-6 border-t border-border">
    <div class="max-w-[1400px] mx-auto">
      <div class="mb-16 section-header" data-animate>
        <span class="mono text-[10px] text-cyan/60 tracking-[0.3em] uppercase">{t(lang, 'problems.tag')}</span>
        <h2 class="text-4xl sm:text-5xl lg:text-6xl font-sans font-black text-text-primary mt-4">{t(lang, 'problems.title')}</h2>
        <p class="text-text-secondary font-sans text-lg max-w-2xl mt-6 leading-relaxed">
          {t(lang, 'problems.description')}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-animate-group>
        {t(lang, 'problems.items').map((anomaly) => (
          <div class="problem-card-home border border-border/50 bg-surface/30 p-8 group" data-animate-stagger>
            <div class="flex items-center gap-2 mb-3">
              <div class="w-2 h-2 bg-red-400 rounded-full animate-pulse"></div>
              <span class="error-code mono text-[10px] text-red-400/80 tracking-widest uppercase">{anomaly.code}</span>
            </div>
            <h3 class="text-xl font-sans font-bold text-text-primary mt-2 uppercase">{anomaly.title}</h3>
            <p class="mono text-[10px] text-text-dim mt-2">{t(lang, 'problems.impactLabel')} {anomaly.impact}</p>
            <p class="text-text-secondary font-sans text-sm mt-4 leading-relaxed">{anomaly.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ WRITING PREVIEW ═══ -->
  <section class="py-24 lg:py-32 px-6 border-t border-border">
    <div class="max-w-[1400px] mx-auto">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12" data-animate>
        <div class="section-header">
          <span class="mono text-[10px] text-cyan/60 tracking-[0.3em] uppercase">// WRITING</span>
          <h2 class="text-4xl sm:text-5xl lg:text-6xl font-sans font-black text-text-primary mt-4">Latest Thoughts.</h2>
        </div>
        <a href="/en/writing" class="mono text-[10px] text-text-dim hover:text-cyan transition-colors uppercase tracking-widest shrink-0 pb-2">
          [ VIEW ALL ] →
        </a>
      </div>

      <div class="space-y-0" data-animate-group>
        {articles.slice(0, 3).map((article, i) => (
          <a
            href={`/en/writing/${article.id}`}
            class="group flex flex-col md:flex-row md:items-center justify-between gap-4 py-6 border-b border-border/30 hover:border-cyan/30 transition-all"
            data-animate-stagger
          >
            <div class="flex items-center gap-6 flex-1 min-w-0">
              <span class="mono text-[28px] font-black text-white/[0.06] shrink-0 hidden sm:block">{String(i + 1).padStart(2, '0')}</span>
              <div class="min-w-0">
                <h3 class="font-sans text-lg sm:text-xl font-bold text-text-primary uppercase tracking-tight group-hover:text-cyan transition-colors truncate">{article.title}</h3>
                <div class="flex items-center gap-3 mt-1">
                  {article.tags.map(tag => (
                    <span class="mono text-[8px] text-text-dim uppercase tracking-wider">{tag}</span>
                  ))}
                </div>
              </div>
            </div>
            <div class="flex items-center gap-4 shrink-0">
              <span class="mono text-[10px] text-text-dim">{article.read}</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-text-dim group-hover:text-cyan group-hover:translate-x-1 transition-all"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 0X05 COMPETENCIAS TÉCNICAS ═══ -->
  <Skills lang={lang} />

  <!-- ═══ CTA ═══ -->
  <section class="py-24 lg:py-32 px-6 border-t border-border">
    <div class="max-w-[800px] mx-auto text-center" data-animate>
      <span class="mono text-[10px] text-cyan/60 tracking-[0.3em] uppercase">{t(lang, 'cta.tag')}</span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-sans font-black text-text-primary mt-6">
        {t(lang, 'cta.title')}
      </h2>
      <p class="text-text-secondary font-sans text-lg mt-6 leading-relaxed">
        {t(lang, 'cta.description')}
      </p>
      <div class="mt-10">
        <a href="/en/contact" class="inline-block px-10 py-4 bg-cyan text-void mono text-[11px] tracking-[0.2em] font-bold uppercase btn-primary">
          {t(lang, 'cta.button')}
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Hero sequential animation
  function initHeroSequence() {
    const backdrop = document.getElementById('hero-backdrop');
    const elements = document.querySelectorAll('.hero-element');

    // Fade in backdrop first
    setTimeout(() => {
      if (backdrop) backdrop.style.opacity = '1';
    }, 800);

    // Sequentially reveal each element based on data-hero-delay
    elements.forEach((el) => {
      const delay = parseInt((el as HTMLElement).dataset.heroDelay || '0', 10);
      setTimeout(() => el.classList.add('hero-visible'), delay);
    });
  }

  document.addEventListener('astro:page-load', initHeroSequence);
</script>
