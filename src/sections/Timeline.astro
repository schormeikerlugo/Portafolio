---
import { type Lang } from '../i18n';

interface Job {
  role: string;
  company: string;
  period: string;
  description: string;
  tech: string[];
}

interface Props {
  lang?: Lang;
  title: string;
  missionPrefix: string;
  jobs: Job[];
}

const { lang = 'es', title, missionPrefix, jobs } = Astro.props;
---

<section class="py-24 px-6 border-t border-border">
  <div class="max-w-[1400px] mx-auto">
    <h2 class="text-3xl sm:text-4xl font-sans font-black text-text-primary mb-16 uppercase text-center md:text-left" data-animate>{title}</h2>

    <div class="timeline-container relative">
      <!-- Vertical line (desktop) -->
      <div class="timeline-line absolute left-[24px] md:left-[140px] top-0 bottom-0 w-px hidden md:block">
        <div class="timeline-line-fill h-0 w-full bg-gradient-to-b from-cyan via-cyan/40 to-transparent"></div>
      </div>

      <!-- Jobs -->
      <div class="space-y-0">
        {jobs.map((job, i) => (
          <div class="timeline-item group relative pl-14 md:pl-[200px] py-8" data-animate-stagger>
            <!-- Node dot -->
            <div class="timeline-dot absolute left-[18px] md:left-[134px] top-10 w-3 h-3 border-2 border-cyan/40 bg-void rounded-full z-10 group-hover:border-cyan group-hover:bg-cyan/20 group-hover:shadow-[0_0_12px_rgba(0,229,255,0.4)] transition-all duration-300">
            </div>

            <!-- Year badge (desktop: left of line, mobile: inline) -->
            <div class="absolute left-0 md:left-0 top-10 w-[50px] md:w-[120px] text-right hidden md:block">
              <span class="mono text-[10px] text-cyan/60 uppercase tracking-widest font-bold group-hover:text-cyan transition-colors">
                {job.period.split(' ')[0]} {job.period.split(' ')[1]}
              </span>
            </div>

            <!-- Content card -->
            <div class="timeline-card border border-border/30 bg-surface/20 p-6 sm:p-8 hover:border-cyan/20 transition-all duration-300 relative overflow-hidden">
              <!-- HUD corners on hover -->
              <div class="absolute top-1 left-1 w-2.5 h-2.5 border-t border-l border-cyan opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
              <div class="absolute bottom-1 right-1 w-2.5 h-2.5 border-b border-r border-cyan opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

              <!-- Mission ID -->
              <div class="flex items-center justify-between mb-3">
                <span class="mono text-[10px] text-cyan uppercase tracking-widest font-bold">
                  {missionPrefix}{String(i + 1).padStart(2, '0')}
                </span>
                <span class="mono text-[9px] text-text-dim md:hidden">{job.period}</span>
              </div>

              <!-- Role + Company -->
              <h3 class="text-lg sm:text-xl font-sans font-bold text-text-primary uppercase group-hover:text-cyan transition-colors">{job.role}</h3>
              <p class="mono text-[10px] text-text-dim mt-1">{job.company}</p>

              <!-- Full period (mobile) -->
              <p class="mono text-[10px] text-text-dim mt-1 md:hidden">{job.period}</p>

              <!-- Description -->
              <p class="text-text-secondary font-sans text-sm mt-4 leading-relaxed max-w-2xl">{job.description}</p>

              <!-- Tech stack -->
              <div class="flex flex-wrap gap-2 mt-4">
                {job.tech.map((tech) => (
                  <span class="mono text-[9px] text-text-dim border border-border/30 px-2 py-0.5 uppercase tracking-wider hover:border-cyan/30 hover:text-cyan/60 transition-colors">{tech}</span>
                ))}
              </div>

              <!-- Bottom accent on hover -->
              <div class="absolute bottom-0 left-0 w-0 h-[2px] bg-cyan/40 group-hover:w-full transition-all duration-500"></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* Timeline line fill animation on scroll */
  .timeline-line-fill {
    transition: height 0.1s linear;
  }

  /* Timeline dot pulse when in view */
  .timeline-item.visible .timeline-dot {
    animation: dot-pulse 2s ease infinite;
  }
  @keyframes dot-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(0, 229, 255, 0.2); }
    50% { box-shadow: 0 0 0 6px rgba(0, 229, 255, 0); }
  }

  /* Card slide-in */
  .timeline-card {
    transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
  }
  .timeline-item:hover .timeline-card {
    transform: translateX(4px);
    box-shadow: 0 0 20px rgba(0, 229, 255, 0.04);
  }
</style>

<script>
  function initTimeline() {
    const line = document.querySelector('.timeline-line-fill') as HTMLElement;
    const items = document.querySelectorAll('.timeline-item');
    if (!line || !items.length) return;

    // Animate line fill based on scroll
    const container = document.querySelector('.timeline-container') as HTMLElement;
    if (!container) return;

    const updateLine = () => {
      const rect = container.getBoundingClientRect();
      const containerTop = rect.top;
      const containerHeight = rect.height;
      const viewportHeight = window.innerHeight;

      // How much of the container is above the viewport center
      const scrolled = Math.max(0, (viewportHeight * 0.6) - containerTop);
      const progress = Math.min(1, scrolled / containerHeight);

      line.style.height = `${progress * 100}%`;
    };

    window.addEventListener('scroll', updateLine, { passive: true });
    updateLine();

    // Mark items as visible when they enter viewport
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      },
      { threshold: 0.3 }
    );
    items.forEach((item) => observer.observe(item));
  }

  document.addEventListener('astro:page-load', initTimeline);
</script>
