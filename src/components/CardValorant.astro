---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n';
import { label, projectUrl, type Project } from '../lib/projects';

interface Props {
  project: Project;
  lang?: Lang;
  preview?: string;
}

const { project, lang = 'es', preview } = Astro.props;
const searchText = [project.title, project.tagline, ...project.stack, label('subcategory', project.subcategory, lang)].join(' ').toLowerCase();
const { slug, title, tagline, cover, stack, category, subcategory, summary, year, status } = project;
---

<a
  href={projectUrl(slug, lang)}
  class="group relative w-full block border-b border-border/40 hover:bg-surface/30 transition-all duration-300 py-8 px-4"
  data-category={category}
  data-subcategory={subcategory}
  data-year={year}
  data-search={searchText}
  data-preview={preview}
>
  <!-- Hover Indicator Line -->
  <div class="absolute left-0 w-[2px] h-0 bg-cyan top-1/2 -translate-y-1/2 group-hover:h-full opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none"></div>

  <div class="flex flex-col md:flex-row gap-6 md:gap-8 items-start">
    <!-- 1. Meta & Title -->
    <div class="w-full md:w-[35%] flex flex-col gap-3 shrink-0">
      <div class="flex items-center gap-3 opacity-80">
        <span class:list={['status-dot', `status-${status}`]} title={label('status', status, lang)} aria-hidden="true"></span>
        <span class="mono text-[11px] text-cyan uppercase tracking-[0.2em] font-bold">{year}</span>
        <span class="text-text-dim mono text-[11px]">//</span>
        <span class="mono text-[11px] text-text-secondary uppercase tracking-[0.2em]">{tagline}</span>
      </div>

      <h3 class="font-sans text-2xl sm:text-3xl font-bold text-text-primary tracking-tight uppercase flex items-center gap-3 group-hover:text-cyan transition-colors">
        {title}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 -translate-y-1 translate-x-1 group-hover:opacity-100 group-hover:translate-y-0 group-hover:translate-x-0 transition-all text-cyan">
          <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
        </svg>
      </h3>

      <span class="mono text-[11px] text-text-dim tracking-widest uppercase mt-1">
        [{label('subcategory', subcategory, lang)}] · {label('status', status, lang)}
      </span>
    </div>

    <!-- 2. Description & Tags -->
    <div class="w-full md:w-[45%] flex flex-col justify-between gap-4 h-full">
      <p class="text-sm sm:text-base text-text-secondary leading-relaxed font-sans line-clamp-3">{summary}</p>

      <div class="flex flex-wrap gap-2 pt-2">
        {stack.slice(0, 4).map((tag) => (
          <span class="mono text-[11px] text-text-dim border border-border/50 px-2 py-1 bg-void/50 rounded-sm uppercase tracking-wider group-hover:border-cyan/30 group-hover:text-cyan transition-colors">
            {tag}
          </span>
        ))}
        {stack.length > 4 && (
          <span class="mono text-[11px] text-text-dim px-1 py-1 uppercase tracking-wider">+{stack.length - 4}</span>
        )}
      </div>
    </div>

    <!-- 3. Thumbnail -->
    <div class="w-full md:w-[20%] flex flex-col items-end justify-end self-stretch shrink-0">
      <div class="relative w-full aspect-video md:max-w-[200px] rounded-sm overflow-hidden border border-border/30 group-hover:border-cyan/50 transition-colors mt-auto" transition:name={`cover-${slug}`}>
        <Image
          src={cover}
          alt={title}
          widths={[400, 640]}
          sizes="(min-width: 768px) 200px, 100vw"
          loading="lazy"
          class="hover-reveal absolute inset-0 h-full w-full object-cover object-top grayscale opacity-30 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700"
        />
        <div class="absolute inset-0 bg-cyan/10 opacity-0 group-hover:opacity-100 mix-blend-overlay transition-opacity duration-500"></div>
      </div>
    </div>
  </div>
</a>
