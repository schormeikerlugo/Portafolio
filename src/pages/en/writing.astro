---
import Base from '../../layouts/Base.astro';
import { breadcrumbSchema } from '../../lib/seo';
import { articles } from '../../data/articles';
import { t, type Lang } from '../../i18n';

const lang: Lang = 'en';

const filterCategories = [
  { id: 'all', label: 'All' },
  { id: 'design', label: 'Design', tags: ['UX', 'BRUTALISM', 'DESIGN_SYSTEMS', 'SCALABILITY', 'COLOR_THEORY', 'DESIGN_TOKENS', 'TYPOGRAPHY', 'A11Y'] },
  { id: 'dev', label: 'Development', tags: ['PERFORMANCE', 'REACT', 'ASTRO', 'ARCHITECTURE', 'CSS', 'ANIMATIONS', 'TAILWIND', 'ENGINEERING', 'SEO', 'PORTFOLIO'] },
  { id: 'ai', label: 'Artificial Intelligence', tags: ['AI', 'LOCAL_LLMS', 'PROMPT_ENG'] },
  { id: 'workflow', label: 'Workflow', tags: ['LINUX', 'WORKFLOW'] },
];

const KEYWORDS = ['React', 'Vite', 'Framer Motion', 'GSAP', 'Tailwind', 'Astro', 'Ollama', 'Figma', 'CSS', 'JavaScript', 'Design System', 'Design Engineer', 'WCAG', 'IntersectionObserver'];
const FUNCTIONS = ['optimize', 'build', 'deploy', 'configure', 'render', 'design', 'solve', 'create', 'implement'];

function syntaxHighlight(text: string): string {
  let r = text;
  r = r.replace(/(\/\/[^\n<]*)/g, '<span class="text-white/30 italic">$1</span>');
  const kwP = new RegExp(`\\b(${KEYWORDS.join('|')})\\b`, 'gi');
  r = r.replace(kwP, '<span style="color:#00e5ff;font-weight:500">$1</span>');
  const fnP = new RegExp(`\\b(${FUNCTIONS.join('|')})\\b`, 'gi');
  r = r.replace(fnP, '<span style="color:#fbbf24;font-weight:500">$1</span>');
  return r;
}
---

<Base
  lang="en"
  title="Writing"
  description="Documentación técnica de Schormeiker Lugo — Artículos sobre ingeniería de interfaces, diseño sistémico, rendimiento frontend e inteligencia artificial aplicada."
  keywords={['blog', 'frontend', 'design systems', 'React', 'Astro', 'AI', 'prompt engineering', 'CSS', 'accesibilidad', 'rendimiento web']}
  jsonLd={breadcrumbSchema([
    { name: 'Home', url: 'https://schormeiker.com' },
    { name: 'Writing', url: 'https://schormeiker.com/writing' },
  ])}
>
  <section id="writing" class="relative z-10 py-24 sm:py-32 px-6 bg-void min-h-[80vh]">
    <div class="max-w-[1400px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mb-24">
        <div class="lg:col-span-8" data-animate>
          <header class="space-y-6">
            <div class="flex items-center gap-4">
              <span class="bg-cyan/10 text-cyan px-2 py-0.5 rounded-sm mono text-[10px] font-bold tracking-tighter">{t(lang, 'writing.badge')}</span>
              <span class="mono text-[10px] text-white/40 tracking-[0.4em] uppercase">
                {t(lang, 'writing.sectionTag')}
              </span>
            </div>
            <h1 class="text-[clamp(1.5rem,5vw,3rem)] md:text-8xl font-sans text-white tracking-tighter uppercase leading-[0.85] font-black break-words">
              {t(lang, 'writing.title')}
            </h1>
          </header>
        </div>
        <div class="lg:col-span-4 flex items-end" data-animate>
          <p class="text-white/40 mono text-[10px] uppercase tracking-widest leading-relaxed border-l-2 border-cyan/30 pl-8">
            {t(lang, 'writing.description')}
          </p>
        </div>
      </div>

      <!-- Filters -->
      <div class="mb-8 flex flex-wrap justify-center md:justify-start gap-3" data-animate>
        {filterCategories.map((fc) => (
          <button
            class:list={['writing-filter mono text-[10px] uppercase tracking-widest px-4 py-2 border transition-all', fc.id === 'all' ? 'border-cyan/30 text-cyan bg-cyan/10' : 'border-border/50 text-text-dim hover:border-cyan/30 hover:text-cyan']}
            data-filter-id={fc.id}
            data-filter-tags={fc.id === 'all' ? '' : fc.tags?.join(',')}
          >
            {fc.label}
          </button>
        ))}
      </div>

      <div id="writing-list" class="border-t border-white/5" data-animate-group>
        {articles.map((paper, i) => (
          <a
            href={`/en/writing/${paper.id}`}
            class="writing-item group block py-10 border-b border-white/5 hover:border-cyan/30 transition-all relative overflow-hidden"
            data-tags={paper.tags.join(',')}
          >
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 relative z-10" data-animate-stagger>
              <div class="space-y-4 max-w-4xl">
                <div class="flex items-center gap-3">
                  <span class="mono text-[8px] text-cyan/60 uppercase tracking-widest font-bold">{t(lang, 'writing.sessionPrefix')} {String(i + 1).padStart(2, '0')}</span>
                  <span class="text-white/10 mono text-[8px]">//</span>
                  <div class="flex gap-2">
                    {paper.tags.map(t => (
                      <span class="mono text-[8px] text-white/20 uppercase tracking-tighter">{t}</span>
                    ))}
                  </div>
                </div>
                <h2 class="font-sans text-3xl md:text-5xl font-bold text-white uppercase tracking-tighter group-hover:text-cyan transition-colors leading-[0.9]">
                  {paper.title}
                </h2>
                <p class="text-white/30 text-xs md:text-sm uppercase tracking-tight max-w-2xl group-hover:text-white/50 transition-colors leading-relaxed" set:html={syntaxHighlight(paper.summary)} />
              </div>

              <div class="flex items-center gap-8 md:text-right shrink-0">
                <div class="space-y-1">
                  <div class="flex items-center gap-2 md:justify-end opacity-40">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-cyan"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    <span class="mono text-[9px] uppercase tracking-widest font-bold">{t(lang, 'writing.readTime')}</span>
                  </div>
                  <div class="mono text-[11px] text-white/80 font-bold">{paper.read}</div>
                </div>
                <div class="p-4 bg-white/5 border border-white/10 rounded-sm group-hover:bg-cyan group-hover:text-void transition-all">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                </div>
              </div>
            </div>

            <!-- Background tag decor -->
            <div class="absolute top-1/2 left-0 -translate-y-1/2 -translate-x-full group-hover:translate-x-10 transition-transform duration-700 opacity-5 pointer-events-none">
              <span class="font-sans text-9xl font-black italic whitespace-nowrap uppercase">{paper.tags[0]}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  function initWritingFilters() {
    const filterBtns = document.querySelectorAll('.writing-filter');
    const items = document.querySelectorAll('.writing-item');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filterId = (btn as HTMLElement).dataset.filterId;
        const filterTags = ((btn as HTMLElement).dataset.filterTags || '').split(',').filter(Boolean);

        filterBtns.forEach(b => {
          b.classList.remove('text-cyan', 'border-cyan/30', 'bg-cyan/10');
          b.classList.add('text-text-dim', 'border-border/50');
        });
        btn.classList.add('text-cyan', 'border-cyan/30', 'bg-cyan/10');
        btn.classList.remove('text-text-dim', 'border-border/50');

        items.forEach((item) => {
          const el = item as HTMLElement;
          const itemTags = (el.dataset.tags || '').split(',');
          if (filterId === 'all') {
            el.style.display = '';
          } else {
            const match = itemTags.some(tag => filterTags.includes(tag));
            el.style.display = match ? '' : 'none';
          }
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initWritingFilters);
</script>
