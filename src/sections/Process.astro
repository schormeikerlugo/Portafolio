---
import { t, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;

const steps = [
  {
    id: '01',
    title: lang === 'en' ? 'Discovery' : 'Descubrimiento',
    description: lang === 'en'
      ? 'I analyze your product, audience, and technical constraints. I identify structural failure points and define measurable objectives.'
      : 'Analizo tu producto, audiencia y restricciones técnicas. Identifico puntos de fallo estructurales y defino objetivos medibles.',
    icon: 'M21 21l-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z',
    color: '#00e5ff',
  },
  {
    id: '02',
    title: lang === 'en' ? 'Design' : 'Diseño',
    description: lang === 'en'
      ? 'I create user flows, wireframes, and high-fidelity prototypes in Figma. Every design decision is validated before writing a single line of code.'
      : 'Creo user flows, wireframes y prototipos de alta fidelidad en Figma. Cada decisión de diseño se valida antes de escribir una sola línea de código.',
    icon: 'M9.53 16.122a3 3 0 0 0-5.78 1.128 2.25 2.25 0 0 1-2.4 2.245 4.5 4.5 0 0 0 8.4-2.245c0-.399-.078-.78-.22-1.128Zm0 0a15.998 15.998 0 0 0 3.388-1.62m-5.043-.025a15.994 15.994 0 0 1 1.622-3.395m3.42 3.42a15.995 15.995 0 0 0 4.764-4.648l3.876-5.814a1.151 1.151 0 0 0-1.597-1.597L14.146 6.32a15.996 15.996 0 0 0-4.649 4.763m3.42 3.42a6.776 6.776 0 0 0-3.42-3.42',
    color: '#a78bfa',
  },
  {
    id: '03',
    title: lang === 'en' ? 'Development' : 'Desarrollo',
    description: lang === 'en'
      ? 'I build the interface with React, Astro, and Tailwind CSS. Pixel-perfect fidelity with the design, optimized performance, and accessible from day one.'
      : 'Construyo la interfaz con React, Astro y Tailwind CSS. Fidelidad pixel-perfect con el diseño, rendimiento optimizado y accesibilidad desde el día uno.',
    icon: 'M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5',
    color: '#fbbf24',
  },
  {
    id: '04',
    title: lang === 'en' ? 'Delivery & Iteration' : 'Entrega e Iteración',
    description: lang === 'en'
      ? 'I deploy, audit performance with Lighthouse, and iterate based on real data. The product launches optimized and ready to scale.'
      : 'Despliego, audito rendimiento con Lighthouse e itero en base a datos reales. El producto se lanza optimizado y listo para escalar.',
    icon: 'M3 8.689c0-.864.933-1.406 1.683-.977l7.108 4.061a1.125 1.125 0 0 1 0 1.954l-7.108 4.061A1.125 1.125 0 0 1 3 16.811V8.69ZM12.75 8.689c0-.864.933-1.406 1.683-.977l7.108 4.061a1.125 1.125 0 0 1 0 1.954l-7.108 4.061a1.125 1.125 0 0 1-1.683-.977V8.69Z',
    color: '#34d399',
  },
];
---

<section class="py-24 lg:py-32 px-6 border-t border-border">
  <div class="max-w-[1400px] mx-auto">
    <div class="mb-16 section-header" data-animate>
      <span class="mono text-[10px] text-cyan/60 tracking-[0.3em] uppercase">
        {lang === 'en' ? '0X03 // WORKFLOW' : '0X03 // PROCESO_DE_TRABAJO'}
      </span>
      <h2 class="text-4xl sm:text-5xl lg:text-6xl font-sans font-black text-text-primary mt-4">
        {lang === 'en' ? 'How I Work.' : 'Cómo Trabajo.'}
      </h2>
      <p class="text-text-secondary font-sans text-lg max-w-2xl mt-6 leading-relaxed">
        {lang === 'en'
          ? 'A structured process that transforms product vision into measurable results. Four phases, zero ambiguity.'
          : 'Un proceso estructurado que transforma la visión de producto en resultados medibles. Cuatro fases, cero ambigüedad.'}
      </p>
    </div>

    <!-- Process Steps -->
    <div class="relative" data-animate-group>
      <!-- Connection line (desktop) -->
      <div class="hidden lg:block absolute top-1/2 left-0 right-0 h-px bg-border/30 -translate-y-1/2 z-0"></div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 relative z-10">
        {steps.map((step, i) => (
          <div class="process-step group" data-animate-stagger>
            <div class="border border-border/30 bg-void hover:border-white/15 transition-all duration-500 p-8 h-full flex flex-col relative overflow-hidden">
              <!-- Step number + icon -->
              <div class="flex items-center justify-between mb-6">
                <span class="mono text-[32px] font-black" style={`color: ${step.color}20`}>{step.id}</span>
                <div class="w-12 h-12 border flex items-center justify-center transition-all duration-300 group-hover:scale-110" style={`border-color: ${step.color}30; background: ${step.color}08`}>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke={step.color} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:rotate-6"><path d={step.icon}/></svg>
                </div>
              </div>

              <!-- Title -->
              <h3 class="text-xl font-sans font-bold text-text-primary uppercase mb-3 group-hover:text-white transition-colors">{step.title}</h3>

              <!-- Description -->
              <p class="text-text-secondary font-sans text-sm leading-relaxed flex-1">{step.description}</p>

              <!-- Bottom accent line -->
              <div class="mt-6 h-px w-0 group-hover:w-full transition-all duration-500" style={`background: ${step.color}40`}></div>

              <!-- Hover corner brackets -->
              <div class="absolute top-2 left-2 w-3 h-3 border-t border-l opacity-0 group-hover:opacity-100 transition-opacity duration-300" style={`border-color: ${step.color}60`}></div>
              <div class="absolute bottom-2 right-2 w-3 h-3 border-b border-r opacity-0 group-hover:opacity-100 transition-opacity duration-300" style={`border-color: ${step.color}60`}></div>
            </div>

            <!-- Arrow connector (between cards, desktop only) -->
            {i < 3 && (
              <div class="hidden lg:flex absolute top-1/2 -translate-y-1/2 -right-3 z-20">
                <svg width="6" height="10" viewBox="0 0 6 10" fill="none" class="text-text-dim"><path d="M1 1l4 4-4 4" stroke="currentColor" stroke-width="1"/></svg>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
