---
import { t, getAlternateUrl, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;

const prefix = lang === 'en' ? '/en' : '';

const NAV_LINKS = [
  { label: t(lang, 'nav.home'), path: `${prefix}/` },
  { label: t(lang, 'nav.about'), path: `${prefix}/about` },
  { label: t(lang, 'nav.work'), path: `${prefix}/work` },
  { label: t(lang, 'nav.services'), path: `${prefix}/services` },
  { label: t(lang, 'nav.writing'), path: `${prefix}/writing` },
  { label: t(lang, 'nav.contact'), path: `${prefix}/contact` },
];

const currentPath = Astro.url.pathname;
const alternateUrl = getAlternateUrl(currentPath, lang === 'es' ? 'en' : 'es');
const toggleLabel = lang === 'es' ? 'EN' : 'ES';
const toggleLang = lang === 'es' ? 'en' : 'es';
const logoHref = lang === 'en' ? '/en' : '/';
const homePath = `${prefix}/`;
const isActivePath = (path: string) => {
  if (path === homePath) return currentPath === '/' || currentPath === '/en' || currentPath === '/en/';
  if (path.endsWith('/work')) return currentPath.startsWith(path) || currentPath.includes('/portfolio/');
  return currentPath.startsWith(path);
};
---

<a href="#main" class="skip-link mono text-[11px] uppercase tracking-[0.2em]">{t(lang, 'nav.skip')}</a>

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 px-6 navbar-entry" aria-label="Main">
  <div class="max-w-[1400px] mx-auto flex items-center justify-between h-14">
    <a href={logoHref} class="flex items-center gap-2 group">
      <span class="w-1.5 h-1.5 bg-cyan shadow-[0_0_8px_rgba(0,229,255,0.7)]" aria-hidden="true"></span>
      <span class="mono text-[11px] font-bold tracking-[0.2em] text-white group-hover:text-cyan transition-colors">SL // SYSTEM</span>
    </a>

    <div class="hidden md:flex items-center">
      <div class="nav-links relative flex items-center gap-0 mr-6">
        {NAV_LINKS.map(({ label, path }, i) => {
          const active = isActivePath(path);
          return (
            <a
              href={path}
              class:list={['nav-link relative px-3.5 py-2 mono text-[11px] uppercase tracking-[0.18em] transition-colors duration-200', active ? 'text-white' : 'text-white/60 hover:text-white']}
              aria-current={active ? 'page' : undefined}
              data-active={active ? 'true' : undefined}
            >
              <span class:list={['mr-1 text-[10px]', active ? 'text-cyan' : 'text-white/35']} aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{label}
            </a>
          );
        })}
        <span class="nav-indicator" aria-hidden="true"></span>
      </div>

      <div class="flex items-center gap-3 h-6 border-l border-white/5 pl-4">
        <a href="https://github.com/schormeikerlugo" target="_blank" rel="noopener" class="text-text-dim hover:text-cyan transition-colors" aria-label="GitHub">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65S8.93 17.38 9 18v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        </a>
        <a href="https://behance.net/schormeikerlugo" target="_blank" rel="noopener" class="text-text-dim hover:text-cyan transition-colors" aria-label="Behance">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M22 7h-7V5h7v2zm1.726 10c-.442 1.297-2.029 3-5.101 3-3.074 0-5.564-1.729-5.564-5.675 0-3.91 2.325-5.92 5.466-5.92 3.082 0 4.964 1.782 5.375 4.426.078.506.109 1.188.095 2.14H15.97c.13 3.211 3.483 3.312 4.588 2.029h3.168zm-7.686-4h4.965c-.105-1.547-1.136-2.219-2.477-2.219-1.466 0-2.277.768-2.488 2.219zm-9.574 6.988H0V5.021h6.953c5.476.081 5.58 5.444 2.72 6.906 3.461 1.26 3.577 8.061-3.207 8.061zM3 11h3.584c2.508 0 2.906-3-.312-3H3v3zm3.391 3H3v3.016h3.341c3.055 0 2.868-3.016.05-3.016z"/></svg>
        </a>
        <a href="https://www.linkedin.com/in/schormeiker/" target="_blank" rel="noopener" class="text-text-dim hover:text-cyan transition-colors" aria-label="LinkedIn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
        </a>
      </div>

      <a
        href={alternateUrl}
        data-lang-switch={toggleLang}
        hreflang={toggleLang}
        class="ml-3 mono text-[11px] text-text-dim hover:text-cyan transition-colors tracking-[0.2em] uppercase px-2 py-1 border border-white/10 hover:border-cyan/40"
      >
        {toggleLabel}
      </a>

      <span class="ml-5 hidden lg:flex items-center gap-2 mono text-[11px] tracking-[0.2em] uppercase text-white/70">
        <span class="live-led" aria-hidden="true"></span>{t(lang, 'nav.available')}
      </span>
    </div>

    <button
      id="mobile-toggle"
      class="md:hidden p-2 text-text-secondary hover:text-cyan transition-colors"
      aria-label={t(lang, 'nav.openMenu')}
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-label-open={t(lang, 'nav.openMenu')}
      data-label-close={t(lang, 'nav.closeMenu')}
    >
      <svg id="menu-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="14" y1="18" y2="18"/></svg>
      <svg id="close-icon" class="hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  </div>

  <div class="scroll-progress" aria-hidden="true"><span id="scroll-progress-bar"></span></div>
</nav>

<div id="mobile-menu" class="fixed inset-0 z-40 bg-void/95 backdrop-blur-2xl md:hidden mobile-menu-hidden" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="flex flex-col justify-center h-full px-8 gap-2">
    {NAV_LINKS.map(({ label, path }, i) => {
      const active = isActivePath(path);
      return (
        <a
          href={path}
          class:list={['mobile-link flex items-baseline gap-4 py-3 border-b border-white/5 transition-colors', active ? 'text-cyan' : 'text-text-primary hover:text-cyan']}
          style={`--i:${i}`}
          aria-current={active ? 'page' : undefined}
        >
          <span class="mono text-[11px] text-white/45 tracking-[0.2em]">{String(i + 1).padStart(2, '0')}</span>
          <span class="font-sans font-black text-3xl uppercase tracking-tight">{label}</span>
        </a>
      );
    })}
    <div class="mobile-link flex items-center justify-between mt-8" style={`--i:${NAV_LINKS.length}`}>
      <span class="flex items-center gap-2 mono text-[11px] tracking-[0.2em] uppercase text-white/70"><span class="live-led" aria-hidden="true"></span>{t(lang, 'nav.available')}</span>
      <a href={alternateUrl} data-lang-switch={toggleLang} hreflang={toggleLang} class="mono text-sm text-text-dim hover:text-cyan tracking-[0.2em] uppercase px-4 py-2 border border-white/10 hover:border-cyan/40">{toggleLabel}</a>
    </div>
  </div>
</div>

<script>
  import { onPageLoad, prefersReducedMotion } from '../lib/lifecycle';

  function initNavbar(signal: AbortSignal) {
    const navbar = document.getElementById('navbar');
    if (!navbar) return;

    if (sessionStorage.getItem('navbar-loaded') || prefersReducedMotion()) {
      navbar.classList.remove('navbar-entry');
    } else {
      navbar.addEventListener('animationend', () => {
        navbar.classList.remove('navbar-entry');
        sessionStorage.setItem('navbar-loaded', '1');
      }, { once: true });
    }

    // Sliding active indicator
    const links = navbar.querySelector<HTMLElement>('.nav-links');
    const indicator = navbar.querySelector<HTMLElement>('.nav-indicator');
    const moveTo = (el: HTMLElement | null) => {
      if (!indicator || !links) return;
      if (!el) { indicator.style.opacity = '0'; return; }
      indicator.style.opacity = '1';
      indicator.style.transform = `translateX(${el.offsetLeft + 14}px)`;
      indicator.style.width = `${el.offsetWidth - 28}px`;
    };
    const activeLink = links?.querySelector<HTMLElement>('[data-active]') ?? null;
    moveTo(activeLink);
    links?.querySelectorAll<HTMLElement>('.nav-link').forEach((a) => {
      a.addEventListener('mouseenter', () => moveTo(a), { signal });
      a.addEventListener('focus', () => moveTo(a), { signal });
    });
    links?.addEventListener('mouseleave', () => moveTo(activeLink), { signal });

    // Scroll: background, hide/show, progress
    const bar = document.getElementById('scroll-progress-bar');
    let lastY = window.scrollY;
    let ticking = false;
    const update = () => {
      const y = window.scrollY;
      navbar.classList.toggle('navbar-scrolled', y > 20);
      if (y < 20 || y < lastY - 5) navbar.style.transform = 'translateY(0)';
      else if (y > lastY + 5 && !document.body.classList.contains('menu-open')) navbar.style.transform = 'translateY(-100%)';
      const max = document.documentElement.scrollHeight - window.innerHeight;
      if (bar) bar.style.transform = `scaleX(${max > 0 ? Math.min(1, y / max) : 0})`;
      lastY = y;
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { requestAnimationFrame(update); ticking = true; }
    }, { passive: true, signal });
    update();

    // Mobile menu
    const toggle = document.getElementById('mobile-toggle');
    const menu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');
    if (!toggle || !menu) return;

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) || '');
      menuIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);
      document.body.classList.toggle('menu-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) {
        menu.classList.remove('mobile-menu-hidden', 'mobile-menu-closing');
        menu.classList.add('mobile-menu-visible');
        menu.querySelector<HTMLElement>('a')?.focus();
      } else if (menu.classList.contains('mobile-menu-visible')) {
        menu.classList.remove('mobile-menu-visible');
        menu.classList.add('mobile-menu-closing');
        setTimeout(() => {
          menu.classList.remove('mobile-menu-closing');
          menu.classList.add('mobile-menu-hidden');
        }, prefersReducedMotion() ? 0 : 300);
        toggle.focus();
      }
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'), { signal });
    document.addEventListener('keydown', (e) => {
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      if (e.key === 'Escape') { setOpen(false); return; }
      if (e.key === 'Tab') {
        const focusables = [toggle, ...menu.querySelectorAll<HTMLElement>('a')];
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    }, { signal });
    signal.addEventListener('abort', () => {
      document.body.classList.remove('menu-open');
      document.body.style.overflow = '';
    });
  }

  onPageLoad(initNavbar);
</script>
