---
import { t, getAlternateUrl, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;

const prefix = lang === 'en' ? '/en' : '';

const NAV_LINKS = [
  { label: t(lang, 'nav.home'), path: `${prefix}/` },
  { label: t(lang, 'nav.about'), path: `${prefix}/about` },
  { label: t(lang, 'nav.work'), path: `${prefix}/work` },
  { label: t(lang, 'nav.services'), path: `${prefix}/services` },
  { label: t(lang, 'nav.writing'), path: `${prefix}/writing` },
  { label: t(lang, 'nav.contact'), path: `${prefix}/contact` },
];

const currentPath = Astro.url.pathname;
const alternateUrl = getAlternateUrl(currentPath, lang === 'es' ? 'en' : 'es');
const toggleLabel = lang === 'es' ? 'EN' : 'ES';
const toggleLang = lang === 'es' ? 'en' : 'es';
const logoHref = lang === 'en' ? '/en' : '/';
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 px-6 transition-all duration-300" style="background: transparent;">
  <div class="max-w-[1400px] mx-auto flex items-center justify-between h-14">
    <!-- Logo -->
    <a href={logoHref} class="flex items-center gap-1.5 group">
      <span class="mono text-[11px] font-bold tracking-[0.3em] text-white group-hover:text-cyan transition-colors">
        SL // SYSTEM
      </span>
    </a>

    <!-- Desktop Links -->
    <div class="hidden md:flex items-center">
      <div class="flex items-center gap-0 mr-6">
        {NAV_LINKS.map(({ label, path }) => {
          const isActive = path === '/' ? currentPath === '/' : currentPath.startsWith(path);
          return (
            <a
              href={path}
              class:list={[
                'relative px-4 py-2 mono text-[10px] uppercase tracking-[0.2em] transition-colors duration-200',
                isActive ? 'text-cyan' : 'text-white/40 hover:text-white',
              ]}
            >
              {label}
            </a>
          );
        })}
      </div>

      <!-- Social Links -->
      <div class="flex items-center gap-3 h-6 border-l border-white/5 pl-4">
        <a href="https://github.com/schormeikerlugo" target="_blank" rel="noopener" class="text-text-dim hover:text-cyan transition-colors" aria-label="GitHub">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65S8.93 17.38 9 18v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        </a>
        <a href="https://behance.net/schormeikerlugo" target="_blank" rel="noopener" class="text-text-dim hover:text-cyan transition-colors" aria-label="Behance">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M22 7h-7V5h7v2zm1.726 10c-.442 1.297-2.029 3-5.101 3-3.074 0-5.564-1.729-5.564-5.675 0-3.91 2.325-5.92 5.466-5.92 3.082 0 4.964 1.782 5.375 4.426.078.506.109 1.188.095 2.14H15.97c.13 3.211 3.483 3.312 4.588 2.029h3.168zm-7.686-4h4.965c-.105-1.547-1.136-2.219-2.477-2.219-1.466 0-2.277.768-2.488 2.219zm-9.574 6.988H0V5.021h6.953c5.476.081 5.58 5.444 2.72 6.906 3.461 1.26 3.577 8.061-3.207 8.061zM3 11h3.584c2.508 0 2.906-3-.312-3H3v3zm3.391 3H3v3.016h3.341c3.055 0 2.868-3.016.05-3.016z"/></svg>
        </a>
        <a href="https://www.linkedin.com/in/schormeiker/" target="_blank" rel="noopener" class="text-text-dim hover:text-cyan transition-colors" aria-label="LinkedIn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
        </a>
      </div>

      <!-- Language Toggle -->
      <a
        href={alternateUrl}
        data-lang-switch={toggleLang}
        class="ml-3 mono text-[10px] text-text-dim hover:text-cyan transition-colors tracking-[0.2em] uppercase px-2 py-1 border border-white/10 hover:border-cyan/40"
      >
        {toggleLabel}
      </a>
    </div>

    <!-- Mobile Hamburger -->
    <button id="mobile-toggle" class="md:hidden p-2 text-text-secondary hover:text-cyan transition-colors" aria-label="Toggle menu">
      <svg id="menu-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      <svg id="close-icon" class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  </div>
</nav>

<!-- Mobile Menu Overlay -->
<div id="mobile-menu" class="fixed inset-0 z-40 bg-void/95 backdrop-blur-2xl md:hidden hidden">
  <div class="flex flex-col items-center justify-center h-full gap-8">
    {NAV_LINKS.map(({ label, path }) => {
      const homePath = lang === 'en' ? '/en' : '/';
      const isActive = path === homePath ? (currentPath === '/' || currentPath === '/en' || currentPath === '/en/') : currentPath.startsWith(path);
      return (
        <a
          href={path}
          class:list={[
            'mono text-lg tracking-[0.3em] transition-colors',
            isActive ? 'text-cyan' : 'text-text-secondary hover:text-white',
          ]}
        >
          {isActive && <span class="text-cyan mr-2">›</span>}
          {label}
        </a>
      );
    })}

    <!-- Mobile Language Toggle -->
    <a
      href={alternateUrl}
      data-lang-switch={toggleLang}
      class="mono text-sm text-text-dim hover:text-cyan transition-colors tracking-[0.3em] uppercase mt-4 px-4 py-2 border border-white/10 hover:border-cyan/40"
    >
      {toggleLabel}
    </a>
  </div>
</div>

<script>
  function initNavbar() {
    const navbar = document.getElementById('navbar');
    if (!navbar) return;

    let lastY = 0;
    let ticking = false;

    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          const currentY = window.scrollY;
          const atTop = currentY < 20;

          if (atTop) {
            navbar.style.transform = 'translateY(0)';
            navbar.style.background = 'transparent';
            navbar.style.backdropFilter = 'none';
            navbar.style.webkitBackdropFilter = 'none';
            navbar.style.borderBottom = 'none';
          } else if (currentY < lastY - 5) {
            navbar.style.transform = 'translateY(0)';
            navbar.style.background = 'rgba(0, 0, 0, 0.65)';
            navbar.style.backdropFilter = 'blur(20px)';
            navbar.style.webkitBackdropFilter = 'blur(20px)';
            navbar.style.borderBottom = '1px solid rgba(255, 255, 255, 0.06)';
          } else if (currentY > lastY + 5) {
            navbar.style.transform = 'translateY(-100%)';
          }

          lastY = currentY;
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });

    // Mobile menu toggle
    const toggle = document.getElementById('mobile-toggle');
    const menu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');

    toggle?.addEventListener('click', () => {
      const isOpen = !menu?.classList.contains('hidden');
      menu?.classList.toggle('hidden');
      menuIcon?.classList.toggle('hidden');
      closeIcon?.classList.toggle('hidden');
      document.body.style.overflow = isOpen ? '' : 'hidden';
    });
  }

  document.addEventListener('astro:page-load', initNavbar);
</script>
