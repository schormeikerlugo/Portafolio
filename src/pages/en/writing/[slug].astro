---
import Base from '../../../layouts/Base.astro';
import { articles } from '../../../data/articles';
import { articleSchema, breadcrumbSchema } from '../../../lib/seo';
import { t, type Lang } from '../../../i18n';

const lang: Lang = 'en';

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const articleIdx = articles.findIndex(a => a.id === article.id);
const prevArticle = articleIdx > 0 ? articles[articleIdx - 1] : null;
const nextArticle = articleIdx < articles.length - 1 ? articles[articleIdx + 1] : null;

// Convert date for meta
const months: Record<string, string> = { JAN: '01', FEB: '02', MAR: '03', APR: '04', MAY: '05', JUN: '06', JUL: '07', AUG: '08', SEP: '09', OCT: '10', NOV: '11', DEC: '12' };
const [mon, year] = article.date.split(' ');
const isoDate = `${year}-${months[mon] || '01'}-01`;

// Syntax highlighting
const TECH = ['React', 'Vite', 'Framer Motion', 'GSAP', 'Tailwind', 'Astro', 'Ollama', 'Figma', 'CSS', 'JavaScript', 'HTML', 'Supabase', 'PostgreSQL', 'Neovim', 'Hyprland', 'Arch Linux', 'WCAG', 'JSON-LD', 'Lighthouse', 'IntersectionObserver', 'Node.js', 'Storybook', 'Rust', 'Lightning CSS', 'Wayland', 'GPU', 'HMR', 'SSG', 'SPA', 'SEO', 'Kitty', 'Tmux', 'Zsh', 'Rofi', 'Firefox', 'Canvas', 'DOM', 'TypeScript'];
const CONCEPTS = ['Design System', 'Design Engineer', 'Brutalismo Refinado', 'design tokens', 'tokens', 'componentes', 'micro-interacciones', 'arquitectura', 'hidratación', 'renderizado', 'prototipado', 'bundle', 'viewport', 'reflow', 'lazy loading', 'memoización', 'chain-of-thought', 'prompt', 'prompts'];
const WARNINGS = ['deuda técnica', 'deuda visual', 'fricción', 'latencia', 'sobrecarga', 'penalización', 'abandono', 'fatiga', 'confusión', 'ambigüedad', 'inconsistencia', 'fragmentación', 'excluyente', 'regresivo'];

function highlightWords(text: string): string {
  const tokens: { start: number; end: number; html: string }[] = [];
  let m: RegExpExecArray | null;

  const commentRe = /(\/\/\s*[A-Z_:.\s\d]+)$/g;
  while ((m = commentRe.exec(text)) !== null) {
    tokens.push({ start: m.index, end: m.index + m[0].length, html: `<span class="hl-dim">${m[1]}</span>` });
  }
  const codeRe = /`([^`]+)`/g;
  while ((m = codeRe.exec(text)) !== null) {
    tokens.push({ start: m.index, end: m.index + m[0].length, html: `<code class="hl-inline-code">${m[1]}</code>` });
  }
  const strRe = /"([^"]+)"/g;
  while ((m = strRe.exec(text)) !== null) {
    tokens.push({ start: m.index, end: m.index + m[0].length, html: `<span class="hl-green">"${m[1]}"</span>` });
  }

  tokens.sort((a, b) => a.start - b.start);
  const clean: typeof tokens = [];
  let cursor = 0;
  for (const tok of tokens) {
    if (tok.start >= cursor) { clean.push(tok); cursor = tok.end; }
  }

  let result = '';
  let pos = 0;
  for (const tok of clean) {
    if (tok.start > pos) result += colorize(text.substring(pos, tok.start));
    result += tok.html;
    pos = tok.end;
  }
  if (pos < text.length) result += colorize(text.substring(pos));
  return result;
}

function colorize(segment: string): string {
  let r = segment;
  const warnP = new RegExp(`(${WARNINGS.join('|')})`, 'gi');
  r = r.replace(warnP, '<span class="hl-red">$1</span>');
  const techP = new RegExp(`\\b(${TECH.join('|').replace(/\./g, '\\.')})\\b`, 'g');
  r = r.replace(techP, '<span class="hl-cyan">$1</span>');
  const conceptP = new RegExp(`(${CONCEPTS.join('|')})`, 'gi');
  r = r.replace(conceptP, '<span class="hl-amber">$1</span>');
  r = r.replace(/\b(\d+(?:\.\d+)?(?:%|ms|KB|px|s|B|GB|k\+?)?)\b/g, '<span class="hl-purple">$1</span>');
  return r;
}
---

<Base
  lang="en"
  title={article.title}
  description={article.summary}
  ogImage={article.cover}
  ogType="article"
  keywords={[...article.tags, 'blog', 'frontend', 'diseño']}
  article={{ publishedTime: isoDate, author: 'Schormeiker Lugo' }}
  jsonLd={[
    articleSchema(article),
    breadcrumbSchema([
      { name: 'Home', url: 'https://schormeikerlugo.com' },
      { name: 'Writing', url: 'https://schormeikerlugo.com/writing' },
      { name: article.title, url: `https://schormeikerlugo.com/writing/${article.id}` },
    ]),
  ]}
>
  <section class="pt-28 pb-24 px-6">
    <div class="max-w-4xl mx-auto">
      <!-- Back -->
      <div class="flex justify-center md:justify-start mb-16">
        <a href="/en/writing" class="inline-flex items-center gap-3 mono text-[10px] text-cyan uppercase tracking-[0.4em] hover:text-white transition-colors">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
          {t(lang, 'writing.backToList')}
        </a>
      </div>

      <article class="space-y-12">
        <!-- Header -->
        <header class="space-y-6 text-center md:text-left" data-animate>
          <div class="flex items-center justify-center md:justify-start gap-4 opacity-40">
            <time class="mono text-[10px] text-white uppercase tracking-widest" datetime={isoDate}>{article.date}</time>
            <span class="text-cyan">//</span>
            <span class="mono text-[10px] text-white uppercase tracking-widest">{article.read} {t(lang, 'writing.readSuffix')}</span>
          </div>
          <h1 class="text-4xl md:text-6xl font-sans font-black text-white uppercase tracking-tighter leading-tight">{article.title}</h1>
          <div class="flex flex-wrap justify-center md:justify-start gap-3">
            {article.tags.map(t => (
              <span class="px-3 py-1 bg-white/5 border border-white/10 mono text-[9px] text-cyan uppercase">{t}</span>
            ))}
          </div>
        </header>

        <!-- Cover -->
        <div class="relative aspect-[2/1] w-full overflow-hidden border border-white/10" data-animate>
          <img src={article.cover} alt={article.title} class="w-full h-full object-cover" loading="eager" />
        </div>

        <!-- Content -->
        <div class="space-y-6" data-animate-group>
          {article.content.map((block) => {
            if (block.type === 'image') {
              return (
                <figure class="my-8" data-animate-stagger>
                  <div class="relative overflow-hidden border border-white/10 w-full">
                    <img src={block.value} alt={block.caption || article.title} loading="lazy" class="w-full h-auto block" />
                  </div>
                  {block.caption && (
                    <figcaption class="mono text-[9px] text-white/30 tracking-widest mt-3 text-center md:text-left">{block.caption}</figcaption>
                  )}
                </figure>
              );
            } else if (block.type === 'code') {
              return (
                <div class="my-8 code-block-wrap" data-animate-stagger>
                  <button class="code-copy-btn" data-code={block.value}>COPY</button>
                  <pre class="bg-white/[0.02] border border-white/10 p-4 sm:p-6 overflow-x-auto text-left" style="-webkit-overflow-scrolling:touch"><code class="mono text-[10px] sm:text-xs text-white/60 leading-relaxed whitespace-pre">{block.value}</code></pre>
                </div>
              );
            } else {
              return (
                <p class="text-white/55 text-base md:text-lg leading-[1.85] font-sans text-center md:text-left" style="word-break:break-word;overflow-wrap:break-word" data-animate-stagger set:html={highlightWords(block.value)} />
              );
            }
          })}
        </div>

        <!-- Footer -->
        <footer class="pt-16 border-t border-white/5">
          <div class="mono text-[10px] text-white/20 uppercase tracking-[0.4em] mb-12 text-center md:text-left">
            {t(lang, 'writing.docIdPrefix')} {article.id} {t(lang, 'writing.docIdSuffix')}
          </div>

          <!-- Prev/Next -->
          <div class="flex items-center justify-between">
            {prevArticle ? (
              <a href={`/en/writing/${prevArticle.id}`} class="group flex items-center gap-3 text-text-dim hover:text-cyan transition-colors">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
                <div>
                  <span class="mono text-[9px] uppercase tracking-widest block">{t(lang, 'writing.prev')}</span>
                  <span class="font-sans text-sm font-bold uppercase group-hover:text-cyan transition-colors line-clamp-1">{prevArticle.title}</span>
                </div>
              </a>
            ) : <div />}

            <a href="/en/writing" class="mono text-[10px] text-text-dim hover:text-cyan transition-colors uppercase tracking-widest hidden md:block">
              {t(lang, 'writing.all')}
            </a>

            {nextArticle ? (
              <a href={`/en/writing/${nextArticle.id}`} class="group flex items-center gap-3 text-text-dim hover:text-cyan transition-colors text-right">
                <div>
                  <span class="mono text-[9px] uppercase tracking-widest block">{t(lang, 'writing.next')}</span>
                  <span class="font-sans text-sm font-bold uppercase group-hover:text-cyan transition-colors line-clamp-1">{nextArticle.title}</span>
                </div>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
              </a>
            ) : <div />}
          </div>
        </footer>
      </article>
    </div>
  </section>
</Base>
