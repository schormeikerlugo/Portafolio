---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import SectionRail from '../components/hud/SectionRail.astro';
import { ClientRouter } from 'astro:transitions';
import { t, type Lang } from '../i18n';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  keywords?: string[];
  ogImage?: string;
  ogType?: string;
  article?: { publishedTime?: string; author?: string };
}

const { title, description, lang = 'es', jsonLd, keywords, ogImage, ogType, article } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#050505" />

    <!-- Preload critical fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;700;800;900&display=swap" as="style" />

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <SEOHead title={title} description={description} lang={lang} jsonLd={jsonLd} keywords={keywords} ogImage={ogImage} ogType={ogType} article={article} />
    <ClientRouter />
  </head>
  <body class="relative min-h-screen">
    <!-- Noise Overlay -->
    <div class="noise-overlay" aria-hidden="true"></div>

    <div id="route-progress" aria-hidden="true"></div>
    <Navbar lang={lang} />

    <main id="main" tabindex="-1" class="relative z-10 outline-none">
      <slot />
    </main>

    <SectionRail />

    <Footer lang={lang} />

    <script>
      // Thin top bar while ClientRouter fetches the next page
      const bar = () => document.getElementById('route-progress');
      document.addEventListener('astro:before-preparation', () => bar()?.classList.add('is-loading'));
      document.addEventListener('astro:after-swap', () => {
        const el = bar();
        if (!el) return;
        el.classList.remove('is-loading');
        el.classList.add('is-done');
        setTimeout(() => el.classList.remove('is-done'), 400);
      });
    </script>

    <!-- Vercel Analytics + Speed Insights (deferred) -->
    <script>
      import { inject } from '@vercel/analytics';
      import { injectSpeedInsights } from '@vercel/speed-insights';
      // Defer to avoid blocking LCP
      if ('requestIdleCallback' in window) {
        requestIdleCallback(() => { inject(); injectSpeedInsights(); });
      } else {
        setTimeout(() => { inject(); injectSpeedInsights(); }, 2000);
      }
    </script>

    <!-- Scroll to Top Button — Valorant HUD style (hidden when near footer) -->
    <button
      id="scroll-top"
      class="
        fixed bottom-10 right-6 z-50
        group flex flex-col items-center justify-center gap-1
        w-12 h-12
        border border-cyan/30 bg-void/80
        hover:border-cyan hover:bg-cyan/5
        backdrop-blur-sm
        cursor-pointer
        shadow-[0_0_12px_rgba(0,255,229,0.08)]
        hover:shadow-[0_0_20px_rgba(0,255,229,0.25)]
        scroll-top-hidden
      "
      aria-label={t(lang, 'scrollTop.ariaLabel')}
    >
      <!-- Corner decorations -->
      <span class="absolute top-[3px] left-[3px] w-2 h-2 border-t border-l border-cyan/60 group-hover:border-cyan transition-colors"></span>
      <span class="absolute top-[3px] right-[3px] w-2 h-2 border-t border-r border-cyan/60 group-hover:border-cyan transition-colors"></span>
      <span class="absolute bottom-[3px] left-[3px] w-2 h-2 border-b border-l border-cyan/60 group-hover:border-cyan transition-colors"></span>
      <span class="absolute bottom-[3px] right-[3px] w-2 h-2 border-b border-r border-cyan/60 group-hover:border-cyan transition-colors"></span>

      <!-- Arrow -->
      <svg
        width="14"
        height="14"
        viewBox="0 0 14 14"
        fill="none"
        class="text-cyan/70 group-hover:text-cyan group-hover:-translate-y-0.5 transition-all duration-300"
      >
        <path
          d="M7 12V2M7 2L2.5 6.5M7 2L11.5 6.5"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>

      <!-- Label -->
      <span class="mono text-[11px] text-cyan/80 group-hover:text-cyan tracking-[0.2em] uppercase transition-colors leading-none">
        {t(lang, 'scrollTop.label')}
      </span>
    </button>

    <script>
      import { initAnimations } from '../lib/animations';
      import { onPageLoad, prefersReducedMotion } from '../lib/lifecycle';

      onPageLoad((signal) => {
        initAnimations();

        // Scroll-to-top button
        const btn = document.getElementById('scroll-top');
        const footer = document.querySelector('footer');
        if (btn) {
          let footerVisible = false;
          const updateBtn = () => {
            const show = window.scrollY > 400 && !footerVisible;
            btn.classList.toggle('scroll-top-visible', show);
            btn.classList.toggle('scroll-top-hidden', !show);
          };
          if (footer) {
            const obs = new IntersectionObserver(([entry]) => { footerVisible = entry.isIntersecting; updateBtn(); }, { threshold: 0.05 });
            obs.observe(footer);
            signal.addEventListener('abort', () => obs.disconnect());
          }
          window.addEventListener('scroll', updateBtn, { passive: true, signal });
          btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: prefersReducedMotion() ? 'auto' : 'smooth' }), { signal });
        }

        // Code copy buttons
        document.querySelectorAll<HTMLElement>('.code-copy-btn').forEach((b) => {
          b.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(b.dataset.code || '');
              b.textContent = 'COPIED ✓';
              b.classList.add('copied');
              setTimeout(() => { b.textContent = 'COPY'; b.classList.remove('copied'); }, 2000);
            } catch {
              b.textContent = 'ERROR';
              setTimeout(() => { b.textContent = 'COPY'; }, 1500);
            }
          }, { signal });
        });

        // Terminal typing — once per page per session; instant on reduced motion or click
        document.querySelectorAll<HTMLElement>('.terminal-text').forEach((pre) => {
          const fullText = pre.dataset.terminalText || '';
          const cursor = pre.parentElement?.querySelector('.terminal-cursor');
          const key = `typed:${location.pathname}`;
          const finish = () => { pre.textContent = fullText; cursor?.classList.add('done'); };
          if (!fullText) { pre.textContent = ''; return; }
          if (prefersReducedMotion() || sessionStorage.getItem(key)) { finish(); return; }

          pre.textContent = '';
          let i = 0;
          let skipped = false;
          pre.closest('.terminal-diag')?.addEventListener('click', () => { skipped = true; finish(); }, { once: true, signal });
          const observer = new IntersectionObserver(([entry]) => {
            if (!entry.isIntersecting) return;
            observer.disconnect();
            sessionStorage.setItem(key, '1');
            const speed = Math.max(2, Math.min(8, 800 / fullText.length));
            const type = () => {
              if (skipped || signal.aborted) return;
              if (i < fullText.length) {
                const chunk = Math.min(3, fullText.length - i);
                pre.textContent += fullText.substring(i, i + chunk);
                i += chunk;
                setTimeout(type, speed);
              } else {
                cursor?.classList.add('done');
              }
            };
            type();
          }, { threshold: 0.2 });
          observer.observe(pre);
          signal.addEventListener('abort', () => observer.disconnect());
        });
      });
    </script>

    <script>
      // Language auto-detection and preference persistence
      (function () {
        const saved = localStorage.getItem('lang');
        if (!saved) {
          const browserLang = navigator.language || '';
          if (browserLang.startsWith('en') && window.location.pathname === '/') {
            localStorage.setItem('lang', 'en');
            window.location.href = '/en';
            return;
          }
        }
        // Save lang choice when clicking language toggle links
        document.addEventListener('click', (e) => {
          const target = (e.target as HTMLElement).closest('[data-lang-switch]');
          if (target) {
            const lang = (target as HTMLElement).dataset.langSwitch;
            if (lang) localStorage.setItem('lang', lang);
          }
        });
      })();
    </script>
  </body>
</html>
